# Firebase (servidor — Admin SDK). Nunca commitear valores reales.
FIREBASE_PROJECT_ID=guille-nuesch
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
FIREBASE_STORAGE_BUCKET=guille-nuesch.firebasestorage.app

# Login del panel (valores reales solo en Netlify / .env local)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# Google Analytics 4 — Measurement ID (empieza con "G-"). Se crea en analytics.google.com,
# una propiedad GA4 para el sitio. Se expone al cliente (PUBLIC_) pero solo se inyecta fuera
# de /admin — ver src/layouts/Layout.astro.
PUBLIC_GA_MEASUREMENT_ID=G-QPTDPYF4FC
