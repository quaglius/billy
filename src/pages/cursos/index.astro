---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { db } from '../../lib/firebase-admin';
import { coverForFormato, coverPositionForFormato } from '../../lib/covers';

let cursos: { slug: string; titulo: string; descripcionCorta: string; formato: string }[] = [];
let instancias: { slug: string; titulo: string; visibilidad: string }[] = [];
try {
  const [cursoSnap, instSnap] = await Promise.all([
    db().collection('cursos').where('publicado', '==', true).get(),
    db().collection('instancias').where('visibilidad', 'in', ['publica', 'anonimizada']).get(),
  ]);
  cursos = cursoSnap.docs.map((d) => ({
    slug: String(d.data().slug ?? ''),
    titulo: String(d.data().titulo ?? ''),
    descripcionCorta: String(d.data().descripcionCorta ?? ''),
    formato: String(d.data().formato ?? ''),
  }));
  const cursoTitulo = new Map(cursoSnap.docs.map((d) => [d.id, String(d.data().titulo ?? '')]));
  instancias = instSnap.docs.map((d) => {
    const data = d.data();
    const visibilidad = String(data.visibilidad ?? 'privada');
    const tituloBase = cursoTitulo.get(String(data.cursoId)) ?? 'Curso';
    return {
      slug: String(data.slug ?? ''),
      titulo: String(data.tituloParticular ?? tituloBase),
      visibilidad,
    };
  });
} catch {
  cursos = [];
  instancias = [];
}
---
<Layout title="Cursos — Guille Nuesch">
  <PageHeader titulo="Cursos" actual="Cursos" />
  <div class="page-shell">
    <p class="eyebrow">Encuentro, Taller y Programa</p>
    <div class="curso-grid">
      {cursos.map((c) => (
        <a class="curso-card" href={`/cursos/${c.slug}`}>
          <span class="curso-card__thumb">
            <img
              src={coverForFormato(c.formato)}
              alt=""
              width="640"
              height="400"
              style={`object-position: ${coverPositionForFormato(c.formato)}`}
            />
          </span>
          <div class="curso-card__body">
            <span class="curso-card__chip">{c.formato}</span>
            <h2>{c.titulo}</h2>
            <p>{c.descripcionCorta}</p>
          </div>
        </a>
      ))}
    </div>
    {cursos.length === 0 && (
      <div class="empty-state">
        <p>Los cursos se publican desde el panel.</p>
      </div>
    )}
    {instancias.length > 0 && (
      <>
        <h2>Cursadas visibles</h2>
        <ul>
          {instancias.map((i) => (
            <li>
              <a class="line-hover" href={`/cursos/${i.slug}`}>{i.titulo}</a>
            </li>
          ))}
        </ul>
      </>
    )}
    <p><a class="line-hover" href="/ayuda">Si necesitás ayuda</a></p>
  </div>
</Layout>
