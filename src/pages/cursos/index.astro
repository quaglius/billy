---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { db } from '../../lib/firebase-admin';
import { coverForCurso, coverPositionForCurso } from '../../lib/covers';

let cursos: { slug: string; titulo: string; descripcionCorta: string; formato: string; imagen: string | null }[] = [];
try {
  const cursoSnap = await db().collection('cursos').where('publicado', '==', true).get();
  cursos = cursoSnap.docs.map((d) => ({
    slug: String(d.data().slug ?? ''),
    titulo: String(d.data().titulo ?? ''),
    descripcionCorta: String(d.data().descripcionCorta ?? ''),
    formato: String(d.data().formato ?? ''),
    imagen: d.data().imagenPortadaUrl ? String(d.data().imagenPortadaUrl) : null,
  }));
} catch {
  cursos = [];
}
---
<Layout
  title="Cursos"
  description="Encuentros, talleres y programas de salud mental y prevención de consumos problemáticos para empresas, sindicatos y organismos públicos."
>
  <PageHeader titulo="Cursos" actual="Cursos" />
  <div class="page-shell">
    <p class="eyebrow">Encuentro, Taller y Programa</p>
    <div class="curso-grid">
      {cursos.map((c) => (
        <a class="curso-card" href={`/cursos/${c.slug}`}>
          <span class="curso-card__thumb">
            <img
              src={coverForCurso(c.formato, c.imagen)}
              alt={c.titulo}
              width="640"
              height="400"
              style={`object-position: ${coverPositionForCurso(c.formato, c.imagen)}`}
            />
          </span>
          <div class="curso-card__body">
            <span class="curso-card__chip">{c.formato}</span>
            <h2>{c.titulo}</h2>
            <p>{c.descripcionCorta}</p>
          </div>
        </a>
      ))}
    </div>
    {cursos.length === 0 && (
      <div class="empty-state">
        <p>Los cursos se publican desde el panel.</p>
      </div>
    )}
    <p><a class="line-hover" href="/ayuda">Si necesitás ayuda</a></p>
  </div>
</Layout>
