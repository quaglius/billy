---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BotonPrimario from '../../components/BotonPrimario.astro';
import { db } from '../../lib/firebase-admin';
import { renderMarkdown } from '../../lib/markdown';
import { coverForCurso, coverPositionForCurso } from '../../lib/covers';
import { WHATSAPP_URL } from '../../lib/site';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/cursos');

const cursoSnap = await db().collection('cursos').where('slug', '==', slug).limit(1).get();
const instSnap = await db().collection('instancias').where('slug', '==', slug).limit(1).get();

let titulo = '';
let descripcion = '';
let noindex = false;
let extra = '';
let formato = '';
let objetivos: string[] = [];
let temario: string[] = [];
let imagen: string | null = null;

if (!cursoSnap.empty) {
  const c = cursoSnap.docs[0]!.data();
  if (!c.publicado) return Astro.redirect('/cursos');
  titulo = String(c.titulo ?? '');
  descripcion = String(c.descripcion ?? '');
  formato = String(c.formato ?? '');
  objetivos = Array.isArray(c.objetivos) ? c.objetivos.map(String) : [];
  temario = Array.isArray(c.temario) ? c.temario.map(String) : [];
  imagen = c.imagenPortadaUrl ? String(c.imagenPortadaUrl) : null;
} else if (!instSnap.empty) {
  const inst = instSnap.docs[0]!;
  const data = inst.data();
  const visibilidad = String(data.visibilidad ?? 'privada');
  noindex = visibilidad === 'privada';
  const curso = await db().collection('cursos').doc(String(data.cursoId)).get();
  const cursoData = curso.data() ?? {};
  titulo = String(data.tituloParticular ?? cursoData.titulo ?? '');
  descripcion = String(cursoData.descripcion ?? '');
  extra = String(data.particularidades ?? '');
  formato = String(cursoData.formato ?? '');
  objetivos = Array.isArray(cursoData.objetivos) ? cursoData.objetivos.map(String) : [];
  temario = Array.isArray(cursoData.temario) ? cursoData.temario.map(String) : [];
  imagen = cursoData.imagenPortadaUrl ? String(cursoData.imagenPortadaUrl) : null;
} else {
  return Astro.redirect('/cursos');
}

const html = renderMarkdown(descripcion);
const extraHtml = extra ? renderMarkdown(extra) : '';
const cover = coverForCurso(formato, imagen);
const coverPos = coverPositionForCurso(formato, imagen);
---
<Layout title={titulo} description={descripcion.slice(0, 160)} ogImage={cover} noindex={noindex}>
  <PageHeader titulo={titulo} actual={titulo} crumbs={[{ href: '/', label: 'Inicio' }, { href: '/cursos', label: 'Cursos' }]} />
  <article class="page-shell gn-prose">
    <div class="post-hero">
      <img src={cover} alt={titulo} width="1200" height="630" style={`object-position: ${coverPos}`} />
    </div>
    {formato && <p class="curso-card__chip">{formato}</p>}
    <div set:html={html} />
    {extraHtml && <div set:html={extraHtml} />}
    {objetivos.length > 0 && (
      <>
        <h2>Objetivos</h2>
        <ul>
          {objetivos.map((o) => <li>{o}</li>)}
        </ul>
      </>
    )}
    {temario.length > 0 && (
      <>
        <h2>Temario</h2>
        <ul>
          {temario.map((t) => <li>{t}</li>)}
        </ul>
      </>
    )}
    <p><BotonPrimario href={WHATSAPP_URL} texto="Escribime por WhatsApp" target="_blank" /></p>
    <p><a class="line-hover" href="/ayuda">Si necesitás ayuda</a></p>
  </article>
</Layout>
