---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import BotonPrimario from '../../components/BotonPrimario.astro';
import { db } from '../../lib/firebase-admin';
import { renderMarkdown } from '../../lib/markdown';
import { coverForCurso, coverPositionForCurso } from '../../lib/covers';
import { WHATSAPP_URL } from '../../lib/site';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/cursos');

const cursoSnap = await db().collection('cursos').where('slug', '==', slug).limit(1).get();
if (cursoSnap.empty) return Astro.redirect('/cursos');

const c = cursoSnap.docs[0]!.data();
if (!c.publicado) return Astro.redirect('/cursos');

const titulo = String(c.titulo ?? '');
const descripcion = String(c.descripcion ?? '');
const formato = String(c.formato ?? '');
const objetivos: string[] = Array.isArray(c.objetivos) ? c.objetivos.map(String) : [];
const temario: string[] = Array.isArray(c.temario) ? c.temario.map(String) : [];
const imagen: string | null = c.imagenPortadaUrl ? String(c.imagenPortadaUrl) : null;

const html = renderMarkdown(descripcion);
const cover = coverForCurso(formato, imagen);
const coverPos = coverPositionForCurso(formato, imagen);
---
<Layout title={titulo} description={descripcion.slice(0, 160)} ogImage={cover}>
  <PageHeader titulo={titulo} actual={titulo} crumbs={[{ href: '/', label: 'Inicio' }, { href: '/cursos', label: 'Cursos' }]} />
  <article class="page-shell gn-prose">
    <div class="post-hero">
      <img src={cover} alt={titulo} width="1200" height="630" style={`object-position: ${coverPos}`} />
    </div>
    {formato && <p class="curso-card__chip">{formato}</p>}
    <div set:html={html} />
    {objetivos.length > 0 && (
      <>
        <h2>Objetivos</h2>
        <ul>
          {objetivos.map((o) => <li>{o}</li>)}
        </ul>
      </>
    )}
    {temario.length > 0 && (
      <>
        <h2>Temario</h2>
        <ul>
          {temario.map((t) => <li>{t}</li>)}
        </ul>
      </>
    )}
    <p><BotonPrimario href={WHATSAPP_URL} texto="Escribime por WhatsApp" target="_blank" /></p>
    <p><a class="line-hover" href="/ayuda">Si necesitás ayuda</a></p>
  </article>
</Layout>
