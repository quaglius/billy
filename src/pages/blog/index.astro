---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import BotonPrimario from '../../components/BotonPrimario.astro';
import { listarPostsPublicados, formatFecha } from '../../lib/posts';
import { coverMeta } from '../../lib/covers';
import { WHATSAPP_URL } from '../../lib/site';

const posts = await listarPostsPublicados();
const recientes = posts.slice(0, 3);
---
<Layout title="Blog — Guille Nuesch">
  <PageHeader titulo="Blog" actual="Blog" />
  <div class="blog-layout page-shell">
    <div class="blog-main">
      {posts.length === 0 && (
        <div class="empty-state">
          <h2>Notas en preparación</h2>
          <p>Los borradores se editan en el panel. Cuando se publiquen, aparecen acá con foto, fecha y lectura completa.</p>
        </div>
      )}
      {posts.map((p) => (
        <PostCard
          slug={p.slug}
          titulo={p.titulo}
          bajada={p.bajada}
          imagenPortadaUrl={p.imagenPortadaUrl}
          publicadoEn={p.publicadoEn}
        />
      ))}
    </div>
    <aside class="blog-sidebar">
      <div class="sidebar-widget">
        <h2>Buscar</h2>
        <label>
          <span class="visually-hidden">Buscar notas</span>
          <input class="sidebar-search" id="blog-search" type="search" placeholder="Buscar notas" />
        </label>
      </div>
      {recientes.length > 0 && (
        <div class="sidebar-widget">
          <h2>Recientes</h2>
          {recientes.map((p) => (
            <a class="sidebar-recent" href={`/blog/${p.slug}`}>
              <img
                src={coverMeta(p.slug, p.imagenPortadaUrl).src}
                alt=""
                width="100"
                height="100"
                style={`object-position: ${coverMeta(p.slug, p.imagenPortadaUrl).position}`}
              />
              <span>
                <strong>{p.titulo}</strong>
                <small>{formatFecha(p.publicadoEn).largo}</small>
              </span>
            </a>
          ))}
        </div>
      )}
      <div class="sidebar-widget sidebar-cta">
        <h2>Charlas y talleres</h2>
        <p>Si estás buscando generar un impacto real en tu equipo de trabajo, podemos trabajar juntos.</p>
        <BotonPrimario href={WHATSAPP_URL} texto="WhatsApp" target="_blank" />
      </div>
    </aside>
  </div>
</Layout>
<script>
  const input = document.getElementById('blog-search') as HTMLInputElement | null;
  input?.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    document.querySelectorAll('.post-card').forEach((card) => {
      const text = card.textContent?.toLowerCase() ?? '';
      (card as HTMLElement).hidden = q.length > 0 && !text.includes(q);
    });
  });
</script>
