---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { db } from '../../lib/firebase-admin';
import { renderMarkdown } from '../../lib/markdown';
import { coverMeta } from '../../lib/covers';
import { formatFecha } from '../../lib/posts';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/blog');

const snap = await db().collection('posts').where('slug', '==', slug).limit(1).get();
if (snap.empty) return Astro.redirect('/blog');
const post = snap.docs[0]!.data();
if (post.estado !== 'publicado' || post.archivado === true) return Astro.redirect('/blog');

const html = renderMarkdown(String(post.cuerpoMd ?? ''));
const titulo = String(post.titulo ?? '');
const bajada = String(post.bajada ?? '');
const cover = coverMeta(slug, post.imagenPortadaUrl ? String(post.imagenPortadaUrl) : null);
const pub = post.publicadoEn?.toDate?.() ?? null;
const fecha = formatFecha(pub);

const site = (Astro.site?.toString() ?? 'https://guillenuesch.netlify.app').replace(/\/$/, '');
const isoPublicado = pub ? pub.toISOString() : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: titulo,
  description: bajada,
  image: [`${site}${cover.src}`],
  datePublished: isoPublicado,
  dateModified: isoPublicado,
  author: { '@type': 'Person', name: 'Guillermo Nuesch' },
  publisher: {
    '@type': 'Organization',
    name: 'Guille Nuesch',
    logo: { '@type': 'ImageObject', url: `${site}/marca/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site}/blog/${slug}` },
};
---
<Layout title={titulo} description={bajada} ogImage={cover.src}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <PageHeader titulo={titulo} actual="Nota" crumbs={[{ href: '/', label: 'Inicio' }, { href: '/blog', label: 'Blog' }]} />
  <article class="page-shell gn-prose">
    <div class="post-hero">
      <img src={cover.src} alt={titulo} width="1200" height="630" style={`object-position: ${cover.position}`} />
    </div>
    {fecha.largo && <p class="post-meta">{fecha.largo}</p>}
    <p>{bajada}</p>
    <div set:html={html} />
    <aside class="author-box">
      <img src="/fotos/guille/avatar-sonrisa.png" alt="Guillermo Nuesch" width="88" height="88" />
      <p>Por Guillermo Nuesch, capacitador en Salud Mental y Prevención de Consumos Problemáticos en el ámbito laboral · 25 años de trayectoria</p>
    </aside>
    <p><a class="line-hover" href="/ayuda">Si necesitás ayuda</a></p>
  </article>
</Layout>
