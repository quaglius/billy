---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../lib/firebase-admin';

const { codigo } = Astro.params;
let consigna = '';
let encontrada = false;
let tipo = 'si_no';
let opciones: string[] = [];
let actividadId = '';

if (codigo) {
  const snap = await db().collection('actividades').where('codigo', '==', codigo).limit(1).get();
  if (!snap.empty) {
    encontrada = true;
    const doc = snap.docs[0]!;
    actividadId = doc.id;
    const a = doc.data();
    consigna = String(a.consigna ?? '');
    tipo = String(a.tipo ?? 'si_no');
    opciones = Array.isArray(a.opciones) ? a.opciones.map(String) : [];
  }
}
---
<Layout title="Participar" noindex={true} whatsapp={false}>
  <div class="participate">
    <div class="participate__card">
      {!encontrada && (
        <div class="empty-state">
          <h1>No encontramos esta actividad</h1>
          <p>Revisá el código o volvé a escanear el QR de la pantalla.</p>
        </div>
      )}
      {encontrada && (
        <>
          <p class="eyebrow">Participar</p>
          <h1>{consigna}</h1>
          <form id="form-respuesta" class="participate__form">
            <input type="hidden" name="actividadId" value={actividadId} />
            {tipo === 'si_no' && (
              <div class="si-no">
                <button type="button" data-valor="true">Sí</button>
                <button type="button" data-valor="false">No</button>
              </div>
            )}
            {tipo === 'seleccion_unica' &&
              opciones.map((op) => (
                <label class="opcion-tap">
                  <input type="radio" name="opcion" value={op} required />
                  <span>{op}</span>
                </label>
              ))}
            {tipo === 'seleccion_multiple' &&
              opciones.map((op) => (
                <label class="opcion-tap">
                  <input type="checkbox" name="opciones" value={op} />
                  <span>{op}</span>
                </label>
              ))}
            {tipo === 'numero' && (
              <label>Número <input type="number" name="numero" inputmode="numeric" required /></label>
            )}
            {tipo === 'fecha' && (
              <label>Fecha <input type="date" name="fecha" required /></label>
            )}
            {tipo === 'texto_libre' && (
              <label>Tu respuesta <textarea name="texto" maxlength="60" rows="2" required autofocus></textarea></label>
            )}
            {tipo !== 'si_no' && <button class="participate__enviar" type="submit">Enviar</button>}
          </form>
          <p id="msg" class="msg-ok" hidden></p>
        </>
      )}
    </div>
  </div>
</Layout>

{encontrada && (
  <script define:vars={{ tipo, actividadId, codigo }}>
    if (window.trackEvent) {
      window.trackEvent('participar_vista', { actividad_id: actividadId, codigo: codigo, tipo: tipo });
    }

    const KEY = 'gn_token_navegador';
    if (!localStorage.getItem(KEY)) localStorage.setItem(KEY, crypto.randomUUID());
    const token = localStorage.getItem(KEY);
    const form = document.getElementById('form-respuesta');
    const msg = document.getElementById('msg');

    function mostrar(texto) {
      if (form) form.hidden = true;
      if (msg) {
        msg.hidden = false;
        msg.textContent = texto;
      }
    }

    let enviando = false;

    async function enviar(valor) {
      if (enviando) return;
      enviando = true;
      document.querySelectorAll('.si-no button, .participate__enviar').forEach((b) => (b.disabled = true));
      try {
        const res = await fetch('/api/responder', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ actividadId, tokenNavegador: token, valor }),
        });
        const data = await res.json();
        if (data.estado === 'ya_registrada') {
          mostrar('Ya registramos tu respuesta para esta actividad. Gracias por participar.');
        } else if (data.estado === 'cerrada') {
          mostrar('No pudimos registrar tu respuesta. Probá de nuevo en un momento.');
        } else {
          if (window.trackEvent) {
            window.trackEvent('respuesta_enviada', { actividad_id: actividadId, codigo: codigo, tipo: tipo });
          }
          mostrar('¡Gracias por participar! Ya podés mirar la pantalla.');
        }
      } catch {
        mostrar('No pudimos registrar tu respuesta. Revisá tu conexión y probá de nuevo.');
      }
    }

    document.querySelectorAll('.si-no button').forEach((btn) => {
      btn.addEventListener('click', () => enviar({ valor: btn.dataset.valor === 'true' }));
    });

    form?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const fd = new FormData(form);
      let valor;
      if (tipo === 'seleccion_unica') valor = { opcion: String(fd.get('opcion') ?? '') };
      else if (tipo === 'seleccion_multiple') valor = { opciones: fd.getAll('opciones').map(String) };
      else if (tipo === 'numero') valor = { valor: Number(fd.get('numero')) };
      else if (tipo === 'fecha') valor = { valor: String(fd.get('fecha') ?? '') };
      else valor = { valor: String(fd.get('texto') ?? '').slice(0, 60) };
      enviar(valor);
    });
  </script>
)}
