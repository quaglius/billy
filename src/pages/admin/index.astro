---
import Layout from '../../layouts/Layout.astro';
import AdminChrome from '../../components/AdminChrome.astro';
import { db } from '../../lib/firebase-admin';
import { fechaDeDoc, formatFecha } from '../../lib/fecha';
import { estadoInstancia, etiquetaInstancia } from '../../lib/admin-instancia';

let proximas: {
  id: string;
  nombre: string;
  fechaInicio: Date | null;
  fechaTexto: string;
  estado: string;
  rutaCurso: string;
}[] = [];
let conteos = { cursos: 0, empresas: 0, instancias: 0, posts: 0 };
let errorCarga = '';

try {
  const [instSnap, cursosSnap, empSnap, postsSnap] = await Promise.all([
    db().collection('instancias').get(),
    db().collection('cursos').get(),
    db().collection('empresas').get(),
    db().collection('posts').get(),
  ]);

  conteos = {
    cursos: cursosSnap.size,
    empresas: empSnap.size,
    instancias: instSnap.size,
    posts: postsSnap.size,
  };

  const cursoTitulo = new Map(cursosSnap.docs.map((d) => [d.id, String(d.data().titulo ?? '')]));
  const empresaNombre = new Map(empSnap.docs.map((d) => [d.id, String(d.data().nombre ?? '')]));
  const ahora = new Date();

  proximas = instSnap.docs
    .map((d) => {
      const data = d.data();
      const fechaInicio = data.fechaInicio ? fechaDeDoc(data.fechaInicio) : null;
      const fechaFin = data.fechaFin ? fechaDeDoc(data.fechaFin) : null;
      const cursoId = String(data.cursoId ?? '');
      return {
        id: d.id,
        nombre: etiquetaInstancia(data, cursoTitulo.get(cursoId), empresaNombre.get(String(data.empresaId ?? ''))),
        fechaInicio,
        fechaTexto: fechaInicio ? `${formatFecha(fechaInicio)}${fechaFin ? ` – ${formatFecha(fechaFin)}` : ''}` : 'Sin fecha',
        estado: estadoInstancia(fechaInicio, fechaFin, ahora),
        rutaCurso: `/admin/cursos/${cursoId}`,
      };
    })
    .filter((i) => i.estado === 'en curso' || i.estado === 'próxima')
    .sort((a, b) => (a.fechaInicio?.getTime() ?? Infinity) - (b.fechaInicio?.getTime() ?? Infinity))
    .slice(0, 6);
} catch (err) {
  errorCarga = err instanceof Error ? err.message : 'No se pudo cargar el panel.';
}

const secciones = [
  { href: '/admin/cursos', label: 'Cursos', desc: 'Las plantillas: Encuentro, Taller o Programa.', n: conteos.cursos },
  { href: '/admin/empresas', label: 'Empresas', desc: 'Organizaciones y sindicatos para los que trabajás.', n: conteos.empresas },
  { href: '/admin/instancias', label: 'Instancias', desc: 'Un curso dictado a una empresa, con fechas y actividades.', n: conteos.instancias },
  { href: '/admin/posts', label: 'Posts', desc: 'El blog. Los borradores no se ven en el sitio.', n: conteos.posts },
  { href: '/admin/observatorio', label: 'Observatorio', desc: 'Datos agregados y anónimos de todas las cursadas.', n: null },
];
---
<Layout title="Admin — Guille Nuesch" noindex={true} whatsapp={false}>
  <AdminChrome
    titulo="Lo de hoy"
    subtitulo="Tus próximas instancias y accesos directos a cada sección del panel."
  >
    {errorCarga && <p class="admin-alert">{errorCarga}</p>}

    <h2 class="dash-section-title">Próximas instancias</h2>
    {proximas.length === 0 && !errorCarga && (
      <p>No hay instancias próximas cargadas. Andá a <a href="/admin/instancias">Instancias</a> para cargar una cursada.</p>
    )}
    {proximas.length > 0 && (
      <div class="dash-proximos">
        {proximas.map((i) => (
          <article class="dash-encuentro">
            <div class="dash-encuentro__info">
              <span class:list={['pill-estado', i.estado === 'en curso' ? 'pill-estado--ok' : 'pill-estado--off']}>
                {i.estado}
              </span>
              <h3>{i.nombre}</h3>
              <p class="dash-encuentro__meta">{i.fechaTexto}</p>
            </div>
            <div class="dash-encuentro__acciones">
              <a href={`/admin/instancias/${i.id}`} class="admin-btn-primario">Ver instancia</a>
              <a href={i.rutaCurso} class="admin-btn-secondary">Preguntas y QRs</a>
            </div>
          </article>
        ))}
      </div>
    )}

    <h2 class="dash-section-title">Secciones</h2>
    <div class="dash-secciones">
      {secciones.map((s) => (
        <a class="dash-seccion" href={s.href}>
          <div class="dash-seccion__head">
            <span>{s.label}</span>
            {s.n !== null && <span class="dash-seccion__n">{s.n}</span>}
          </div>
          <p>{s.desc}</p>
        </a>
      ))}
    </div>
  </AdminChrome>
</Layout>
