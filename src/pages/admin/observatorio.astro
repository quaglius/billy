---
import Layout from '../../layouts/Layout.astro';
import AdminChrome from '../../components/AdminChrome.astro';
import { db } from '../../lib/firebase-admin';

const MIN = 30;
let bloques: { consigna: string; total: number; listo: boolean }[] = [];
let errorCarga = '';
try {
  const cursos = await db().collection('cursos').get();
  for (const curso of cursos.docs) {
    const acts = await db().collection('actividades').where('cursoId', '==', curso.id).get();
    const porConsigna = new Map<string, string[]>();
    acts.docs.forEach((a) => {
      const consigna = String(a.data().consigna ?? '');
      const list = porConsigna.get(consigna) ?? [];
      list.push(a.id);
      porConsigna.set(consigna, list);
    });
    for (const [consigna, ids] of porConsigna) {
      let total = 0;
      for (const aid of ids) {
        const r = await db().collection('respuestas').where('actividadId', '==', aid).get();
        total += r.size;
      }
      bloques.push({
        consigna: `${curso.data().titulo}: ${consigna}`,
        total,
        listo: total >= MIN,
      });
    }
  }
} catch (err) {
  errorCarga = err instanceof Error ? err.message : 'No se pudo cargar el Observatorio.';
}
---
<Layout title="Observatorio — Admin" noindex={true} whatsapp={false}>
  <AdminChrome titulo="Observatorio">
    <p>Agregados por curso. Nunca se muestra la empresa.</p>
    {errorCarga && <p class="admin-alert">{errorCarga}</p>}
    <ul>
      {bloques.map((b) => (
        <li>
          {b.consigna}
          {b.listo ? ` — ${b.total} respuestas` : ' — Todavía no hay suficientes respuestas acumuladas para este dato (mínimo 30).'}
        </li>
      ))}
    </ul>
  </AdminChrome>
</Layout>
