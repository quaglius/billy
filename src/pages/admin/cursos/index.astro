---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import AdminCampo from '../../../components/AdminCampo.astro';
import { db } from '../../../lib/firebase-admin';

let cursos: { id: string; titulo: string; slug: string; formato: string; publicado: boolean }[] = [];
let errorCarga = '';
try {
  const snap = await db().collection('cursos').orderBy('titulo').get();
  cursos = snap.docs.map((d) => {
    const data = d.data();
    return {
      id: d.id,
      titulo: String(data.titulo ?? ''),
      slug: String(data.slug ?? ''),
      formato: String(data.formato ?? ''),
      publicado: Boolean(data.publicado),
    };
  });
} catch (err) {
  errorCarga = err instanceof Error ? err.message : 'No se pudieron leer los cursos.';
}
---
<Layout title="Cursos — Admin" noindex={true} whatsapp={false}>
  <AdminChrome titulo="Cursos">
    {Astro.url.searchParams.get('ok') && <p class="admin-ok">Curso creado.</p>}
    {Astro.url.searchParams.get('error') && <p class="admin-alert">Falta el título.</p>}
    {errorCarga && <p class="admin-alert">{errorCarga}</p>}
    {cursos.length > 0 && (
      <table class="admin-table">
        <thead>
          <tr><th>Título</th><th>Formato</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
          {cursos.map((c) => (
            <tr>
              <td>{c.titulo}</td>
              <td>{c.formato}</td>
              <td>
                <span class:list={['pill-estado', c.publicado ? 'pill-estado--ok' : 'pill-estado--off']}>
                  {c.publicado ? 'publicado' : 'borrador'}
                </span>
              </td>
              <td><a href={`/admin/cursos/${c.id}`}>Editar</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
    {cursos.length === 0 && !errorCarga && <p>No hay cursos todavía.</p>}

    <h2>Nuevo curso</h2>
    <form class="admin-form" method="post" action="/api/admin/cursos">
      <AdminCampo titulo="Título" ayuda="Nombre público del curso-tipo, como se ve en el catálogo. Ejemplo: Encuentro de sensibilización.">
        <input type="text" name="titulo" required />
      </AdminCampo>
      <AdminCampo titulo="Descripción corta" ayuda="Una o dos líneas para las tarjetas del listado. Sin jerga.">
        <input type="text" name="descripcionCorta" />
      </AdminCampo>
      <AdminCampo titulo="Descripción" ayuda="Texto más largo de la ficha pública: para qué sirve, cómo se trabaja, qué se lleva la organización.">
        <textarea name="descripcion" rows="4"></textarea>
      </AdminCampo>
      <AdminCampo
        titulo="Formato"
        ayuda="Encuentro: 90 min a media jornada, sensibilización. Taller: 1–2 jornadas, herramientas para delegados y mandos. Programa: 2–3 meses, protocolo propio y seguimiento."
      >
        <select name="formato">
          <option value="encuentro">Encuentro — jornada corta de sensibilización</option>
          <option value="taller">Taller — 1 a 2 jornadas con herramientas</option>
          <option value="programa">Programa — varios meses, con protocolo</option>
        </select>
      </AdminCampo>
      <AdminCampo titulo="Duración" ayuda="Cómo se lo explica en el sitio, en palabras. Ejemplo: 90 min a media jornada.">
        <input type="text" name="duracionTexto" />
      </AdminCampo>
      <AdminCampo titulo="Dirigido a" ayuda="A quién está pensado. Ejemplo: toda la planta, sin distinción de rango.">
        <input type="text" name="dirigidoA" />
      </AdminCampo>
      <AdminCampo titulo="Objetivos" ayuda="Uno por línea. Aparecen como lista en la ficha del curso.">
        <textarea name="objetivos" rows="4"></textarea>
      </AdminCampo>
      <AdminCampo titulo="Temario" ayuda="Uno por línea. Los bloques o temas que se recorren.">
        <textarea name="temario" rows="4"></textarea>
      </AdminCampo>
      <AdminCampo titulo="Publicado" ayuda="Si está marcado, el curso se ve en /cursos. Si no, queda solo en el panel.">
        <span class="admin-campo__check"><input type="checkbox" name="publicado" /> Visible en el catálogo público</span>
      </AdminCampo>
      <button type="submit">Crear</button>
    </form>
  </AdminChrome>
</Layout>
