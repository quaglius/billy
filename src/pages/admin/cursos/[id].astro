---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import AdminCampo from '../../../components/AdminCampo.astro';
import ObservatorioCharts from '../../../components/ObservatorioCharts.astro';
import { db } from '../../../lib/firebase-admin';
import { OBS_MIN, armarDashboard, etiquetaTipo, type ActividadObs, type RespuestaObs } from '../../../lib/observatorio';
import { qrDataUrl, urlParticipante, urlSitio } from '../../../lib/qr';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/cursos');
const doc = await db().collection('cursos').doc(id).get();
if (!doc.exists) return Astro.redirect('/admin/cursos');
const c = doc.data()!;
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const objetivos = Array.isArray(c.objetivos) ? c.objetivos.join('\n') : '';
const temario = Array.isArray(c.temario) ? c.temario.join('\n') : '';
const site = urlSitio(Astro.site);

const TIPO_LABEL: Record<string, string> = {
  si_no: 'Sí / No',
  seleccion_unica: 'Opción única',
  seleccion_multiple: 'Varias opciones',
  numero: 'Número',
  fecha: 'Fecha',
  texto_libre: 'Texto libre — nube de palabras',
};

let actSnap: FirebaseFirestore.QuerySnapshot | null = null;
let errorActividades = '';
try {
  actSnap = await db().collection('actividades').where('cursoId', '==', id).orderBy('orden').get();
} catch (err) {
  errorActividades =
    err instanceof Error && err.message.includes('index')
      ? 'Falta un índice en la base para ordenar las actividades. Si lo acabás de crear, puede tardar unos minutos en estar listo — refrescá en un rato.'
      : err instanceof Error
        ? err.message
        : 'No se pudieron cargar las actividades.';
}
const actividades = actSnap
  ? await Promise.all(
      actSnap.docs.map(async (d) => {
        const data = d.data();
        const codigo = String(data.codigo ?? '');
        const link = urlParticipante(site, codigo);
        return {
          id: d.id,
          tipo: String(data.tipo ?? ''),
          tipoLabel: TIPO_LABEL[String(data.tipo ?? '')] ?? String(data.tipo ?? ''),
          consigna: String(data.consigna ?? ''),
          opciones: Array.isArray(data.opciones) ? data.opciones.join('\n') : '',
          orden: Number(data.orden ?? 0),
          codigo,
          link,
          qr: await qrDataUrl(link, 420),
        };
      }),
    )
  : [];

let dashCurso = null;
let errorObs = '';
try {
  const respSnap = await db().collection('respuestas').where('cursoId', '==', id).get();
  const actividadesObs: ActividadObs[] = (actSnap?.docs ?? []).map((d) => {
    const data = d.data();
    return {
      id: d.id,
      cursoId: String(data.cursoId ?? ''),
      tipo: String(data.tipo ?? ''),
      consigna: String(data.consigna ?? ''),
      opciones: Array.isArray(data.opciones) ? data.opciones.map(String) : null,
    };
  });
  const respuestas: RespuestaObs[] = respSnap.docs.map((d) => {
    const data = d.data();
    const creado = data.creadoEn;
    let creadoEn = new Date();
    if (creado && typeof creado.toDate === 'function') creadoEn = creado.toDate();
    else if (creado instanceof Date) creadoEn = creado;
    return { actividadId: String(data.actividadId ?? ''), cursoId: String(data.cursoId ?? ''), valor: data.valor, creadoEn };
  });
  dashCurso = armarDashboard({
    filtros: { cursoId: id, desde: '', hasta: '' },
    cursos: [{ id, titulo: String(c.titulo ?? '') }],
    actividades: actividadesObs,
    respuestas,
  });
} catch (err) {
  errorObs = err instanceof Error ? err.message : 'No se pudieron cargar las estadísticas de este curso.';
}
---
<Layout title={`Editar curso — ${c.titulo}`} noindex={true} whatsapp={false}>
  <AdminChrome titulo={`Editar: ${c.titulo}`}>
    <p><a href="/admin/cursos">← Cursos</a> · slug <code>{c.slug}</code></p>
    {ok === '1' && <p class="admin-ok">Guardado.</p>}
    {ok === 'editada' && <p class="admin-ok">Actividad actualizada.</p>}
    {ok === 'eliminada' && <p class="admin-ok">Actividad eliminada.</p>}
    {error && <p class="admin-alert">Falta un campo obligatorio.</p>}
    <form class="admin-form" method="post" action="/api/admin/cursos">
      <input type="hidden" name="id" value={id} />
      <AdminCampo titulo="Título" ayuda="Nombre público del curso-tipo, como se ve en el catálogo.">
        <input type="text" name="titulo" value={c.titulo ?? ''} required />
      </AdminCampo>
      <AdminCampo titulo="Descripción corta" ayuda="Una o dos líneas para las tarjetas del listado.">
        <input type="text" name="descripcionCorta" value={c.descripcionCorta ?? ''} />
      </AdminCampo>
      <AdminCampo titulo="Descripción" ayuda="Texto de la ficha pública: para qué sirve y qué se lleva la organización.">
        <textarea name="descripcion" rows="5">{c.descripcion ?? ''}</textarea>
      </AdminCampo>
      <AdminCampo
        titulo="Formato"
        ayuda="Encuentro: jornada corta. Taller: 1–2 jornadas con herramientas. Programa: varios meses, con protocolo."
      >
        <select name="formato">
          <option value="encuentro" selected={c.formato === 'encuentro'}>Encuentro — jornada corta de sensibilización</option>
          <option value="taller" selected={c.formato === 'taller'}>Taller — 1 a 2 jornadas con herramientas</option>
          <option value="programa" selected={c.formato === 'programa'}>Programa — varios meses, con protocolo</option>
        </select>
      </AdminCampo>
      <AdminCampo titulo="Duración" ayuda="Cómo se lo explica en el sitio. Ejemplo: 90 min a media jornada.">
        <input type="text" name="duracionTexto" value={c.duracionTexto ?? ''} />
      </AdminCampo>
      <AdminCampo titulo="Dirigido a" ayuda="A quién está pensado este formato.">
        <input type="text" name="dirigidoA" value={c.dirigidoA ?? ''} />
      </AdminCampo>
      <AdminCampo titulo="Objetivos" ayuda="Uno por línea. Se muestran como lista en la ficha.">
        <textarea name="objetivos" rows="4">{objetivos}</textarea>
      </AdminCampo>
      <AdminCampo titulo="Temario" ayuda="Uno por línea. Los bloques o temas que se recorren.">
        <textarea name="temario" rows="4">{temario}</textarea>
      </AdminCampo>
      <AdminCampo titulo="Publicado" ayuda="Si está marcado, el curso se ve en /cursos. Si no, queda solo en el panel.">
        <span class="admin-campo__check"><input type="checkbox" name="publicado" checked={Boolean(c.publicado)} /> Visible en el catálogo público</span>
      </AdminCampo>
      <button type="submit">Guardar</button>
    </form>

    <section class="curso-act">
      <h2>Actividades de este curso</h2>
      <p class="admin-section-nota">
        Cada pregunta tiene un QR y un código <strong>fijos, para siempre</strong> — imprimilo una
        vez y usalo en todas las cursadas de este curso, sea cual sea la organización o la fecha.
        Antes de proyectar una en una charla nueva, tocá <strong>Renovar</strong> en esa tarjeta:
        la pantalla en vivo arranca a contar de cero, pero nada se borra — el historial completo
        sigue sumando acá abajo y en el Observatorio.
      </p>

      {errorActividades && <p class="admin-alert">{errorActividades}</p>}
      {actividades.length > 0 ? (
        <div class="act-grid">
          {actividades.map((a) => (
            <article class="act-card">
              <header class="act-card__head">
                <span class="act-card__orden">#{a.orden}</span>
                <span class="act-card__tipo">{a.tipoLabel}</span>
              </header>
              <h3 class="act-card__consigna">{a.consigna}</h3>
              <div class="act-card__join">
                <img
                  class="act-card__qr-mini"
                  src={a.qr}
                  width="88"
                  height="88"
                  alt={`QR para participar: ${a.consigna}`}
                  data-qr-abrir
                  data-consigna={a.consigna}
                  data-codigo={a.codigo}
                  data-link={a.link}
                  data-qr={a.qr}
                />
                <div>
                  <p class="act-card__codigo">{a.codigo}</p>
                  <p class="act-card__url">{a.link.replace(/^https?:\/\//, '')}</p>
                </div>
              </div>
              <div class="act-card__acciones">
                <button type="button" class="admin-btn-secondary" data-qr-abrir data-consigna={a.consigna} data-codigo={a.codigo} data-link={a.link} data-qr={a.qr}>
                  Ver QR grande
                </button>
                <button type="button" class="admin-btn-secondary" data-qr-descargar data-consigna={a.consigna} data-codigo={a.codigo} data-link={a.link} data-qr={a.qr}>
                  Descargar QR
                </button>
                <a class="admin-btn-primario" href={`/admin/vivo/${a.id}`}>Ir en vivo</a>
              </div>
              <div class="act-card__acciones act-card__acciones--secundarias">
                <form method="post" action="/api/admin/actividades/renovar" onsubmit={`return confirm('Esto arranca de cero el conteo en vivo de "${a.consigna.replace(/'/g, "\\'")}" para la próxima vez que la proyectes. No borra nada del historial ni del Observatorio. ¿Renovar?')`}>
                  <input type="hidden" name="id" value={a.id} />
                  <input type="hidden" name="volverA" value={`/admin/cursos/${id}`} />
                  <button type="submit" class="admin-btn-secondary">Renovar</button>
                </form>
                <details class="act-card__editar">
                  <summary>Editar</summary>
                  <form class="admin-form" method="post" action="/api/admin/actividades/editar">
                    <input type="hidden" name="id" value={a.id} />
                    <input type="hidden" name="cursoId" value={id} />
                    <AdminCampo titulo="Tipo" ayuda="Cambiar el tipo puede dejar sin sentido las opciones cargadas — revisalas si lo cambiás.">
                      <select name="tipo">
                        <option value="si_no" selected={a.tipo === 'si_no'}>Sí / No</option>
                        <option value="seleccion_unica" selected={a.tipo === 'seleccion_unica'}>Opción única</option>
                        <option value="seleccion_multiple" selected={a.tipo === 'seleccion_multiple'}>Varias opciones</option>
                        <option value="numero" selected={a.tipo === 'numero'}>Número</option>
                        <option value="fecha" selected={a.tipo === 'fecha'}>Fecha</option>
                        <option value="texto_libre" selected={a.tipo === 'texto_libre'}>Texto libre</option>
                      </select>
                    </AdminCampo>
                    <AdminCampo titulo="Consigna" ayuda="El código y el QR no cambian al editar el texto.">
                      <textarea name="consigna" rows="3" required>{a.consigna}</textarea>
                    </AdminCampo>
                    <AdminCampo titulo="Opciones" ayuda="Una por línea. Solo para opción única o varias opciones.">
                      <textarea name="opciones" rows="4">{a.opciones}</textarea>
                    </AdminCampo>
                    <button type="submit">Guardar cambios</button>
                  </form>
                  <form method="post" action="/api/admin/actividades/eliminar" onsubmit="return confirm('¿Eliminar esta actividad? El QR deja de funcionar. Las respuestas ya registradas no se borran.')">
                    <input type="hidden" name="id" value={a.id} />
                    <input type="hidden" name="cursoId" value={id} />
                    <button type="submit" class="admin-link-danger">Eliminar actividad</button>
                  </form>
                </details>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p>Todavía no hay actividades en este curso. Cargá la primera abajo.</p>
      )}

      <h3>Nueva actividad</h3>
      <p class="admin-section-nota">
        Se crea con su código y su QR ya listos, para siempre. Ese mismo QR es el que vas a
        imprimir y reutilizar en cualquier cursada de este curso.
      </p>
      <form class="admin-form" method="post" action="/api/admin/actividades">
        <input type="hidden" name="cursoId" value={id} />
        <AdminCampo
          titulo="Tipo"
          ayuda="Sí/No: dos botones grandes. Opción única: una sola respuesta. Varias opciones: puede marcar más de una. Número o fecha: un valor. Texto libre: arma una nube de palabras con lo que escribe la gente."
        >
          <select name="tipo">
            <option value="si_no">Sí / No</option>
            <option value="seleccion_unica">Opción única — una sola respuesta</option>
            <option value="seleccion_multiple">Varias opciones — puede marcar más de una</option>
            <option value="numero">Número</option>
            <option value="fecha">Fecha</option>
            <option value="texto_libre">Texto libre — nube de palabras</option>
          </select>
        </AdminCampo>
        <AdminCampo titulo="Consigna" ayuda="La pregunta que va a ver la gente en el celular. En primera persona, clara, sin jerga.">
          <textarea name="consigna" rows="3" required></textarea>
        </AdminCampo>
        <AdminCampo titulo="Opciones" ayuda="Solo para opción única o varias opciones: una por línea. En Sí/No, número, fecha o texto libre, dejalo vacío.">
          <textarea name="opciones" rows="4"></textarea>
        </AdminCampo>
        <button type="submit">Crear</button>
      </form>
    </section>

    <section class="curso-obs">
      <h2>Estadísticas de este curso</h2>
      <p class="admin-section-nota">
        El agregado histórico de todas las respuestas anónimas, sumando todas las veces que se
        dictó este curso, sin importar cuántas veces se haya tocado "Renovar" en el medio. Nunca
        muestra empresa ni persona. Hace falta al menos {OBS_MIN} respuestas por consigna para
        ver el detalle. <a href={`/admin/observatorio?curso=${id}`}>Ver en el Observatorio completo →</a>
      </p>
      {errorObs && <p class="admin-alert">{errorObs}</p>}
      {dashCurso && dashCurso.kpis.respuestasEnRango === 0 && !errorObs && (
        <p class="obs-empty">Todavía no hay respuestas registradas para este curso.</p>
      )}
      {dashCurso && dashCurso.kpis.respuestasEnRango > 0 && (
        <>
          <section class="obs-kpis" aria-label="Indicadores de este curso">
            <article class="obs-kpi">
              <p class="obs-kpi__label">Respuestas totales</p>
              <p class="obs-kpi__value">{dashCurso.kpis.respuestasEnRango}</p>
              <p class="obs-kpi__hint">Acumuladas en todas las cursadas de este curso</p>
            </article>
            <article class="obs-kpi">
              <p class="obs-kpi__label">Consignas con dato</p>
              <p class="obs-kpi__value">{dashCurso.kpis.consignasListas} / {dashCurso.kpis.consignasTotal}</p>
              <p class="obs-kpi__hint">Llegaron al umbral de {OBS_MIN} respuestas</p>
            </article>
            {dashCurso.kpis.pctSi !== null && (
              <article class="obs-kpi">
                <p class="obs-kpi__label">% Sí</p>
                <p class="obs-kpi__value">{dashCurso.kpis.pctSi}%</p>
                <p class="obs-kpi__hint">{dashCurso.kpis.siTotal} respuestas sí/no</p>
              </article>
            )}
          </section>

          <ObservatorioCharts charts={dashCurso.charts} />

          <div class="obs-bloques">
            {dashCurso.bloques.map((b, i) => {
              const chartId = `obs-chart-act-${i}`;
              const tieneChart = dashCurso!.charts.some((chart) => chart.id === chartId);
              return (
                <article class:list={['obs-card', b.listo && 'is-ready']}>
                  <header class="obs-card__head">
                    <span class="obs-card__tipo">{etiquetaTipo(b.tipo)}</span>
                  </header>
                  <h3 class="obs-card__consigna">{b.consigna}</h3>
                  {b.listo && b.agregado ? (
                    <>
                      <p class="obs-card__meta">
                        {b.total} respuestas
                        {b.agregado.numero && ` · promedio ${b.agregado.numero.promedio.toFixed(1)}`}
                      </p>
                      {tieneChart && (
                        <div class="obs-chart-card__canvas obs-chart-card__canvas--tall">
                          <canvas id={chartId} aria-label={b.consigna}></canvas>
                        </div>
                      )}
                      {b.agregado.palabras && b.agregado.palabras.length > 0 && (
                        <ul class="obs-words">
                          {b.agregado.palabras.slice(0, 12).map((p) => (
                            <li>{p.palabra} <span>{p.cantidad}</span></li>
                          ))}
                        </ul>
                      )}
                    </>
                  ) : (
                    <>
                      <div class="obs-track" aria-hidden="true">
                        <div class="obs-fill" style={`width: ${Math.min(100, Math.round((b.total / OBS_MIN) * 100))}%`} />
                      </div>
                      <p class="obs-card__meta">{b.total}/{OBS_MIN} — todavía no hay suficientes respuestas.</p>
                    </>
                  )}
                </article>
              );
            })}
          </div>
        </>
      )}
    </section>
  </AdminChrome>

  <dialog id="qr-dialog" class="qr-dialog">
    <button type="button" class="qr-dialog__cerrar" data-qr-cerrar aria-label="Cerrar">✕</button>
    <img id="qr-dialog-img" class="qr-dialog__img" alt="" />
    <p id="qr-dialog-consigna" class="qr-dialog__consigna"></p>
    <p id="qr-dialog-codigo" class="qr-dialog__codigo"></p>
    <p id="qr-dialog-url" class="qr-dialog__url"></p>
  </dialog>
</Layout>

<script src="/admin/qr-tarjetas.js" defer></script>
