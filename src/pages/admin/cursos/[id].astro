---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../lib/firebase-admin';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/cursos');
const doc = await db().collection('cursos').doc(id).get();
if (!doc.exists) return Astro.redirect('/admin/cursos');
const c = doc.data()!;
---
<Layout title={`Editar curso — ${c.titulo}`} noindex={true}>
  <div class="page-shell gn-prose">
    <p><a href="/admin/cursos">← Cursos</a></p>
    <h1>{c.titulo}</h1>
    <p>Slug: {c.slug}</p>
    <p>Formato: {c.formato}</p>
    <p>{c.descripcionCorta}</p>
  </div>
</Layout>
