---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import { db } from '../../../lib/firebase-admin';

let imagenes: { id: string; url: string; nombre: string; origen: string }[] = [];
let errorCarga = '';
try {
  const snap = await db().collection('imagenes').orderBy('nombre').get();
  imagenes = snap.docs.map((d) => {
    const data = d.data();
    return {
      id: d.id,
      url: String(data.url ?? ''),
      nombre: String(data.nombre ?? ''),
      origen: String(data.origen ?? 'estatica'),
    };
  });
} catch (err) {
  errorCarga = err instanceof Error ? err.message : 'No se pudo cargar el banco.';
}

const ok = Astro.url.searchParams.get('ok');
---
<Layout title="Banco de imágenes — Admin" noindex={true} whatsapp={false}>
  <AdminChrome
    titulo="Banco de imágenes"
    subtitulo="Las imágenes que podés elegir para la portada de un curso, un post o el logo de una empresa. Se comparten entre todo el sitio: subís una vez, la usás donde quieras."
  >
    {errorCarga && <p class="admin-alert">{errorCarga}</p>}
    {ok === 'eliminada' && <p class="admin-ok">Imagen eliminada del banco.</p>}

    <div class="img-bank-upload">
      <h2>Subir una nueva</h2>
      <p class="admin-section-nota" data-img-upload-nota>
        Necesita el plan Blaze de Firebase (pago por uso, con capa gratuita) para guardar archivos.
        Si todavía no está activado, vas a ver un aviso al intentar subir — mientras tanto elegís
        de las que ya están abajo.
      </p>
      <div class="img-upload">
        <input type="file" accept="image/png,image/jpeg,image/webp" id="banco-archivo" />
        <button type="button" class="admin-btn-secondary" id="banco-subir">Subir</button>
      </div>
      <p class="admin-alert" id="banco-error" hidden></p>
      <p class="admin-ok" id="banco-ok" hidden></p>
    </div>

    <h2>Todas las imágenes ({imagenes.length})</h2>
    {imagenes.length === 0 ? (
      <p>Todavía no hay imágenes en el banco.</p>
    ) : (
      <div class="img-grid img-grid--banco">
        {imagenes.map((img) => (
          <div class="img-grid__item img-grid__item--banco">
            <img src={img.url} alt={img.nombre} loading="lazy" />
            <span>{img.nombre}</span>
            {img.origen === 'subida' ? (
              <form method="post" action="/api/admin/imagenes/eliminar" onsubmit="return confirm('¿Eliminar esta imagen del banco? Si algún curso, post o empresa la está usando, va a quedar con el link roto.')">
                <input type="hidden" name="id" value={img.id} />
                <button type="submit" class="admin-link-danger">Eliminar</button>
              </form>
            ) : (
              <span class="img-grid__fija">De fábrica</span>
            )}
          </div>
        ))}
      </div>
    )}
  </AdminChrome>
</Layout>

<script>
  const archivo = document.getElementById('banco-archivo') as HTMLInputElement | null;
  const subirBtn = document.getElementById('banco-subir') as HTMLButtonElement | null;
  const errorEl = document.getElementById('banco-error');
  const okEl = document.getElementById('banco-ok');

  subirBtn?.addEventListener('click', async () => {
    if (errorEl) errorEl.hidden = true;
    if (okEl) okEl.hidden = true;
    const file = archivo?.files?.[0];
    if (!file) {
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = 'Elegí un archivo primero.';
      }
      return;
    }
    subirBtn.disabled = true;
    subirBtn.textContent = 'Subiendo…';
    try {
      const fd = new FormData();
      fd.set('archivo', file);
      fd.set('nombre', file.name);
      const res = await fetch('/api/admin/imagenes/subir', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'No se pudo subir la imagen.');
      window.location.reload();
    } catch (err) {
      if (errorEl) {
        errorEl.hidden = false;
        errorEl.textContent = err instanceof Error ? err.message : 'No se pudo subir la imagen.';
      }
      subirBtn.disabled = false;
      subirBtn.textContent = 'Subir';
    }
  });
</script>
