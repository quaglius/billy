---
import Layout from '../../../layouts/Layout.astro';
import { db } from '../../../lib/firebase-admin';
import { qrDataUrl, urlParticipante, urlSitio } from '../../../lib/qr';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/cursos');

const actDoc = await db().collection('actividades').doc(id).get();
if (!actDoc.exists) return Astro.redirect('/admin/cursos');
const a = actDoc.data()!;
const cursoId = String(a.cursoId ?? '');

const cursoDoc = await db().collection('cursos').doc(cursoId).get();
const cursoTitulo = cursoDoc.exists ? String(cursoDoc.data()!.titulo ?? 'Curso') : 'Curso';

let otras: { id: string; orden: number; consigna: string }[] = [];
try {
  const hermanasSnap = await db().collection('actividades').where('cursoId', '==', cursoId).orderBy('orden').get();
  otras = hermanasSnap.docs
    .filter((d) => d.id !== id)
    .map((d) => {
      const data = d.data();
      return { id: d.id, orden: Number(data.orden ?? 0), consigna: String(data.consigna ?? '') };
    });
} catch {
  // El selector de "otra actividad" es un atajo, no algo esencial — si la consulta falla
  // (por ejemplo, un índice que se está construyendo) la pantalla en vivo sigue funcionando
  // igual para la actividad actual, solo sin ese selector.
}

const site = urlSitio(Astro.site);
const codigo = String(a.codigo ?? '');
const link = urlParticipante(site, codigo);
const qr = await qrDataUrl(link, 480);
const renovado = Astro.url.searchParams.get('renovado');
---
<Layout title={`En vivo — ${a.consigna}`} noindex={true} whatsapp={false} chrome={false}>
  <div class="vivo">
    <header class="vivo__bar">
      <nav class="admin-breadcrumb admin-breadcrumb--vivo" aria-label="Migas">
        <a href="/admin">Admin</a>
        <span class="admin-breadcrumb__sep" aria-hidden="true">/</span>
        <a href="/admin/cursos">Cursos</a>
        <span class="admin-breadcrumb__sep" aria-hidden="true">/</span>
        <a href={`/admin/cursos/${cursoId}`}>{cursoTitulo}</a>
        <span class="admin-breadcrumb__sep" aria-hidden="true">/</span>
        <span aria-current="page">En vivo</span>
      </nav>
      <div class="vivo__bar-acciones">
        <a href={`/admin/cursos/${cursoId}`}>Todas las actividades</a>
        <a href={`/admin/vivo/${id}/imprimir`} target="_blank">Imprimir</a>
      </div>
    </header>

    <div class="vivo__stage">
      <aside class="vivo__join">
        <img class="vivo__qr-img" src={qr} width="360" height="360" alt={`QR para participar: ${a.consigna}`} />
        <p class="vivo__hint">Escaneá o entrá con el código</p>
        <p class="vivo__code">{codigo}</p>
        <p class="vivo__url">{link.replace(/^https?:\/\//, '')}</p>
      </aside>
      <section class="vivo__board">
        <p class="vivo__eyebrow">En vivo</p>
        <h1 class="vivo__pregunta">{a.consigna}</h1>
        {renovado && <p class="vivo__reset-ok">Listo — el conteo de acá arranca de nuevo. El historial no se tocó.</p>}
        <div id="grafico" class="vivo__grafico" data-actividad={id} data-tipo={a.tipo}>
          <p class="vivo__esperando">Esperando respuestas…</p>
        </div>
        <div class="vivo__acciones">
          <form
            method="post"
            action="/api/admin/actividades/renovar"
            onsubmit={`return confirm('Esto arranca de cero el conteo en vivo de esta pantalla, para un grupo nuevo. No borra nada del historial ni del Observatorio. ¿Renovar?')`}
          >
            <input type="hidden" name="id" value={id} />
            <input type="hidden" name="volverA" value={`/admin/vivo/${id}`} />
            <button type="submit" class="vivo__reset-btn">Renovar — arrancar de cero</button>
          </form>
          {otras.length > 0 && (
            <label class="vivo__selector">
              Cambiar de actividad
              <select id="selector-actividad">
                <option value="">Elegir…</option>
                {otras.map((o) => (
                  <option value={`/admin/vivo/${o.id}`}>#{o.orden} · {o.consigna.slice(0, 60)}</option>
                ))}
              </select>
            </label>
          )}
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  const selector = document.getElementById('selector-actividad') as HTMLSelectElement | null;
  selector?.addEventListener('change', () => {
    if (selector.value) window.location.href = selector.value;
  });
</script>

<script>
  const el = document.getElementById('grafico');
  if (el) {
    const idAct = el.dataset.actividad;
    let ultimo = '';

    const PALETA = ['#0075ff', '#051229', '#364052', '#7e8590'];

    function barra(etiqueta: string, porcentaje: number) {
      const row = document.createElement('div');
      row.className = 'vivo-bar';
      const head = document.createElement('div');
      head.className = 'vivo-bar__head';
      const name = document.createElement('strong');
      name.textContent = etiqueta;
      const pct = document.createElement('span');
      pct.textContent = `${porcentaje}%`;
      head.append(name, pct);
      const track = document.createElement('div');
      track.className = 'vivo-bar__track';
      const fill = document.createElement('div');
      fill.className = 'vivo-bar__fill';
      fill.style.width = `${porcentaje}%`;
      track.append(fill);
      row.append(head, track);
      return row;
    }

    function nube(palabras: { palabra: string; cantidad: number }[]) {
      const max = Math.max(...palabras.map((p) => p.cantidad), 1);
      const min = Math.min(...palabras.map((p) => p.cantidad), 1);
      const wrap = document.createElement('div');
      wrap.className = 'vivo-nube';
      palabras.forEach((p, i) => {
        const span = document.createElement('span');
        span.className = 'vivo-nube__palabra';
        const escala = max === min ? 0.6 : (p.cantidad - min) / (max - min);
        const tamano = 20 + escala * 64;
        span.style.fontSize = `${tamano}px`;
        span.style.color = PALETA[i % PALETA.length === 1 ? 1 : 0]!;
        span.style.opacity = String(0.55 + escala * 0.45);
        const giro = ((i * 37) % 11) - 5;
        span.style.transform = `rotate(${giro}deg)`;
        span.textContent = p.palabra;
        wrap.append(span);
      });
      return wrap;
    }

    async function tick() {
      try {
        const res = await fetch(`/api/actividad/${idAct}/resultados`);
        if (!res.ok) return;
        const data = await res.json();
        const serial = JSON.stringify(data);
        if (serial === ultimo) return;
        ultimo = serial;
        el.replaceChildren();
        if (data.barras) {
          data.barras.forEach((b: { etiqueta: string; porcentaje: number }) => el.append(barra(String(b.etiqueta), Number(b.porcentaje))));
        } else if (data.numero) {
          const wrap = document.createElement('div');
          wrap.className = 'vivo-num';
          wrap.innerHTML =
            `<p class="vivo-num__big">${data.numero.promedio.toFixed(1)}</p><p>promedio · mín ${data.numero.min} · máx ${data.numero.max}</p>`;
          el.append(wrap);
        } else if (data.palabras && data.palabras.length) {
          el.append(nube(data.palabras));
        } else if (data.semanas) {
          data.semanas.forEach((s: { semana: string; cantidad: number }) => el.append(barra(String(s.semana), Number(s.cantidad))));
        } else {
          const p = document.createElement('p');
          p.className = 'vivo__esperando';
          p.textContent = 'Todavía no hay respuestas en esta sesión.';
          el.append(p);
        }
      } catch {
        /* último dato visible */
      }
    }
    tick();
    setInterval(tick, 2000);
  }
</script>
