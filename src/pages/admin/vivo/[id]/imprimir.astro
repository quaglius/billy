---
import Layout from '../../../../layouts/Layout.astro';
import { db } from '../../../../lib/firebase-admin';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin');
const act = await db().collection('actividades').doc(id).get();
if (!act.exists) return Astro.redirect('/admin/cursos');
const a = act.data()!;
---
<Layout title="Imprimir consigna" noindex={true} whatsapp={false} chrome={false}>
  <div class="print-consigna">
    <p class="eyebrow">Consigna</p>
    <h1>{a.consigna}</h1>
    <p class="vivo__code">{a.codigo}</p>
  </div>
</Layout>
