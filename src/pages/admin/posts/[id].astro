---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import AdminCampo from '../../../components/AdminCampo.astro';
import ImagePicker from '../../../components/ImagePicker.astro';
import { db } from '../../../lib/firebase-admin';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/posts');
const doc = await db().collection('posts').doc(id).get();
if (!doc.exists) return Astro.redirect('/admin/posts');
const p = doc.data()!;
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
---
<Layout title={`Editar post — ${p.titulo}`} noindex={true} whatsapp={false}>
  <AdminChrome titulo="Editar post">
    <p><a href="/admin/posts">← Posts</a> · slug <code>{p.slug}</code></p>
    {ok && <p class="admin-ok">Guardado.</p>}
    {error && <p class="admin-alert">Falta el título.</p>}
    {p.slug === 'protocolo-salud-mental-laboral-srt-2026' && (
      <p class="admin-alert">No publicar sin verificar el texto completo de la Resolución 8/2026 de la SRT contra el Boletín Oficial.</p>
    )}
    <form class="admin-form" method="post" action="/api/admin/posts">
      <input type="hidden" name="id" value={id} />
      <AdminCampo titulo="Título" ayuda="El H1 de la nota y el título que se ve al compartir el link. Incluí la idea principal.">
        <input type="text" name="titulo" value={p.titulo} required />
      </AdminCampo>
      <AdminCampo titulo="Bajada" ayuda="Resumen de 2 o 3 líneas. También se usa como descripción al pegar el link en LinkedIn o WhatsApp.">
        <textarea name="bajada" rows="3">{p.bajada}</textarea>
      </AdminCampo>
      <AdminCampo titulo="Cuerpo" ayuda="El artículo en markdown: títulos con ##, listas con -, negritas con **texto**. No hace falta pegar la firma: el sitio la agrega solo.">
        <textarea name="cuerpoMd" rows="16">{p.cuerpoMd}</textarea>
      </AdminCampo>
      <AdminCampo titulo="Imagen de portada" ayuda="Se usa en /blog, en la nota y al compartir el link. Si no elegís ninguna, se asigna una genérica según el tema.">
        <ImagePicker id={`post-${id}`} name="imagenPortadaUrl" valorActual={p.imagenPortadaUrl ?? ''} />
      </AdminCampo>
      <AdminCampo
        titulo="Estado"
        ayuda="Borrador: solo lo ves en el panel. Publicado: aparece en /blog y en la home. El de la SRT conviene dejarlo en borrador hasta cotejar el Boletín Oficial."
      >
        <select name="estado">
          <option value="borrador" selected={p.estado !== 'publicado'}>Borrador — no se ve en el sitio</option>
          <option value="publicado" selected={p.estado === 'publicado'}>Publicado — visible en el blog</option>
        </select>
      </AdminCampo>
      <button type="submit">Guardar</button>
    </form>
  </AdminChrome>
</Layout>
