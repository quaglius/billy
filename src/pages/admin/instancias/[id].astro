---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import { db } from '../../../lib/firebase-admin';
import { estadoEncuentro } from '../../../lib/encuentro';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/instancias');
const doc = await db().collection('instancias').doc(id).get();
if (!doc.exists) return Astro.redirect('/admin/instancias');
const inst = doc.data()!;

const encSnap = await db()
  .collection('encuentros')
  .where('instanciaId', '==', id)
  .orderBy('orden')
  .get();

const encuentros = encSnap.docs.map((d) => {
  const data = d.data();
  const fechaHora = data.fechaHora?.toDate?.() ?? new Date(data.fechaHora);
  return {
    id: d.id,
    titulo: String(data.titulo ?? ''),
    orden: Number(data.orden ?? 0),
    fechaHora,
    duracionMinutos: data.duracionMinutos ?? null,
    estado: estadoEncuentro(fechaHora, data.duracionMinutos ?? null),
  };
});
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
---
<Layout title={`Instancia — ${inst.slug}`} noindex={true} whatsapp={false}>
  <AdminChrome titulo={String(inst.slug)}>
    {ok && <p class="admin-ok">Guardado.</p>}
    {error && <p class="admin-alert">Faltan el título o la fecha.</p>}
    <p>
      Visibilidad:
      <span class:list={['pill-estado', inst.visibilidad === 'publica' ? 'pill-estado--ok' : 'pill-estado--off']}>
        {inst.visibilidad}
      </span>
      {' · '}
      <a href={`/admin/instancias/${id}/duplicar`}>Duplicar</a>
    </p>
    <h2>Cronograma</h2>
    {encuentros.length > 0 ? (
      <table class="admin-table">
        <thead>
          <tr><th>#</th><th>Encuentro</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
          {encuentros.map((e) => (
            <tr>
              <td>{e.orden}</td>
              <td>{e.titulo}</td>
              <td>
                <span class:list={['pill-estado', e.estado === 'en_curso' ? 'pill-estado--ok' : 'pill-estado--off']}>
                  {e.estado}
                </span>
              </td>
              <td><a href={`/admin/instancias/${id}/encuentros/${e.id}`}>Actividades</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    ) : (
      <p>No hay encuentros todavía.</p>
    )}

    <h2>Nuevo encuentro</h2>
    <form class="admin-form" method="post" action="/api/admin/encuentros">
      <input type="hidden" name="instanciaId" value={id} />
      <label>Orden <input type="number" name="orden" value={encuentros.length + 1} required /></label>
      <label>Título <input type="text" name="titulo" required /></label>
      <label>Fecha y hora <input type="datetime-local" name="fechaHora" required /></label>
      <label>Duración (minutos) <input type="number" name="duracionMinutos" value="120" /></label>
      <button type="submit">Crear</button>
    </form>
  </AdminChrome>
</Layout>
