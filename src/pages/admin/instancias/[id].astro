---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import AdminBreadcrumb from '../../../components/AdminBreadcrumb.astro';
import AdminCampo from '../../../components/AdminCampo.astro';
import ObservatorioCharts from '../../../components/ObservatorioCharts.astro';
import { db } from '../../../lib/firebase-admin';
import { fechaDeDoc, formatFecha } from '../../../lib/fecha';
import { etiquetaInstancia, estadoInstancia, migasInstancia, rutasInstancia } from '../../../lib/admin-instancia';
import { OBS_MIN, armarDashboard, etiquetaTipo, type ActividadObs, type RespuestaObs } from '../../../lib/observatorio';

function toDateInput(v: unknown): string {
  if (!v) return '';
  const d = fechaDeDoc(v);
  if (Number.isNaN(d.getTime())) return '';
  const pad = (n: number) => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/instancias');
const doc = await db().collection('instancias').doc(id).get();
if (!doc.exists) return Astro.redirect('/admin/instancias');
const inst = doc.data()!;

const [cursosSnap, empresasSnap] = await Promise.all([
  db().collection('cursos').orderBy('titulo').get(),
  db().collection('empresas').orderBy('nombre').get(),
]);
const cursos = cursosSnap.docs.map((d) => ({ id: d.id, titulo: String(d.data().titulo ?? d.id) }));
const empresas = empresasSnap.docs.map((d) => ({ id: d.id, nombre: String(d.data().nombre ?? d.id) }));
const cursoTitulo = cursos.find((c) => c.id === inst.cursoId)?.titulo;
const empresaNombre = empresas.find((e) => e.id === inst.empresaId)?.nombre;
const nombre = etiquetaInstancia(inst, cursoTitulo, empresaNombre);
const rutas = rutasInstancia(id);

const fechaInicio = inst.fechaInicio ? fechaDeDoc(inst.fechaInicio) : null;
const fechaFin = inst.fechaFin ? fechaDeDoc(inst.fechaFin) : null;
const estado = estadoInstancia(fechaInicio, fechaFin);

const ok = Astro.url.searchParams.get('ok');
const mensajesOk: Record<string, string> = {
  editada: 'Datos de la instancia guardados.',
  '1': 'Instancia creada.',
};
const errorInstancia = Astro.url.searchParams.get('errorInst') === '1'
  ? 'Faltan curso o empresa.'
  : '';

let dashCurso = null;
let errorObs = '';
const cursoId = String(inst.cursoId ?? '');
try {
  const [actSnap, respSnap] = await Promise.all([
    db().collection('actividades').where('cursoId', '==', cursoId).orderBy('orden').get(),
    db().collection('respuestas').where('cursoId', '==', cursoId).get(),
  ]);
  const actividadesObs: ActividadObs[] = actSnap.docs.map((d) => {
    const data = d.data();
    return {
      id: d.id,
      cursoId: String(data.cursoId ?? ''),
      tipo: String(data.tipo ?? ''),
      consigna: String(data.consigna ?? ''),
      opciones: Array.isArray(data.opciones) ? data.opciones.map(String) : null,
    };
  });
  const respuestas: RespuestaObs[] = respSnap.docs.map((d) => {
    const data = d.data();
    const creado = data.creadoEn;
    let creadoEn = new Date();
    if (creado && typeof creado.toDate === 'function') creadoEn = creado.toDate();
    else if (creado instanceof Date) creadoEn = creado;
    return { actividadId: String(data.actividadId ?? ''), cursoId: String(data.cursoId ?? ''), valor: data.valor, creadoEn };
  });
  dashCurso = armarDashboard({
    filtros: { cursoId, desde: '', hasta: '' },
    cursos: [{ id: cursoId, titulo: cursoTitulo ?? '' }],
    actividades: actividadesObs,
    respuestas,
  });
} catch (err) {
  errorObs = err instanceof Error ? err.message : 'No se pudieron cargar las estadísticas.';
}
---
<Layout title={`Instancia — ${nombre}`} noindex={true} whatsapp={false}>
  <AdminChrome titulo={nombre}>
    <AdminBreadcrumb slot="breadcrumb" crumbs={migasInstancia({ pagina: 'ficha', instanciaId: id, instanciaLabel: nombre })} />
    {ok && mensajesOk[ok] && <p class="admin-ok">{mensajesOk[ok]}</p>}
    <p class="admin-meta">
      <span>{nombre}</span>
      <span class:list={['pill-estado', estado === 'en curso' ? 'pill-estado--ok' : 'pill-estado--off']}>
        {estado}
      </span>
      {fechaInicio && <span>{formatFecha(fechaInicio)}{fechaFin && ` – ${formatFecha(fechaFin)}`}</span>}
      <a href={rutas.duplicar}>Duplicar instancia</a>
      <a href={`/admin/cursos/${cursoId}`}>Ver preguntas y QRs del curso →</a>
    </p>

    <details class="inst-editar">
      <summary>Editar datos de la instancia (empresa, curso, fechas)</summary>
      {errorInstancia && <p class="admin-alert">{errorInstancia}</p>}
      <form class="admin-form" method="post" action="/api/admin/instancias">
        <input type="hidden" name="id" value={id} />
        <AdminCampo titulo="Curso" ayuda="El formato que se está dictando en esta cursada.">
          <select name="cursoId" required>
            {cursos.map((c) => (
              <option value={c.id} selected={inst.cursoId === c.id}>{c.titulo}</option>
            ))}
          </select>
        </AdminCampo>
        <AdminCampo titulo="Empresa" ayuda="Organización, sindicato o área para la que se dicta.">
          <select name="empresaId" required>
            {empresas.map((e) => (
              <option value={e.id} selected={inst.empresaId === e.id}>{e.nombre}</option>
            ))}
          </select>
        </AdminCampo>
        <AdminCampo titulo="Título particular" ayuda="Opcional: si querés que esta cursada tenga un nombre propio distinto al del curso base.">
          <input type="text" name="tituloParticular" value={inst.tituloParticular ?? ''} />
        </AdminCampo>
        <AdminCampo titulo="Modalidad" ayuda="Presencial, virtual o híbrida. Dejalo sin definir si todavía no se decidió.">
          <select name="modalidad">
            <option value="" selected={!inst.modalidad}>Sin definir</option>
            <option value="presencial" selected={inst.modalidad === 'presencial'}>Presencial</option>
            <option value="virtual" selected={inst.modalidad === 'virtual'}>Virtual</option>
            <option value="hibrida" selected={inst.modalidad === 'hibrida'}>Híbrida</option>
          </select>
        </AdminCampo>
        <AdminCampo titulo="Fecha inicio" ayuda="Primer día de esta cursada.">
          <input type="date" name="fechaInicio" value={toDateInput(inst.fechaInicio)} />
        </AdminCampo>
        <AdminCampo titulo="Fecha fin" ayuda="Último día previsto. Puede coincidir con el inicio.">
          <input type="date" name="fechaFin" value={toDateInput(inst.fechaFin)} />
        </AdminCampo>
        <AdminCampo titulo="Particularidades" ayuda="Notas específicas de esta cursada, en markdown. Opcional.">
          <textarea name="particularidades" rows="3">{inst.particularidades ?? ''}</textarea>
        </AdminCampo>
        <button type="submit">Guardar datos de la instancia</button>
      </form>
    </details>

    <section class="curso-obs">
      <h2>Estadísticas</h2>
      <p class="admin-section-nota">
        Es el agregado histórico de <strong>todas</strong> las cursadas de este curso, no solo
        esta instancia: las respuestas anónimas no distinguen empresa. Hace falta al menos
        {OBS_MIN} respuestas por consigna para ver el detalle.
        <a href={`/admin/observatorio?curso=${cursoId}`}>Ver en el Observatorio completo →</a>
      </p>
      {errorObs && <p class="admin-alert">{errorObs}</p>}
      {dashCurso && dashCurso.kpis.respuestasEnRango === 0 && !errorObs && (
        <p class="obs-empty">Todavía no hay respuestas registradas para este curso.</p>
      )}
      {dashCurso && dashCurso.kpis.respuestasEnRango > 0 && (
        <>
          <section class="obs-kpis" aria-label="Indicadores de este curso">
            <article class="obs-kpi">
              <p class="obs-kpi__label">Respuestas totales</p>
              <p class="obs-kpi__value">{dashCurso.kpis.respuestasEnRango}</p>
              <p class="obs-kpi__hint">Acumuladas en todas las cursadas de este curso</p>
            </article>
            <article class="obs-kpi">
              <p class="obs-kpi__label">Consignas con dato</p>
              <p class="obs-kpi__value">{dashCurso.kpis.consignasListas} / {dashCurso.kpis.consignasTotal}</p>
              <p class="obs-kpi__hint">Llegaron al umbral de {OBS_MIN} respuestas</p>
            </article>
            {dashCurso.kpis.pctSi !== null && (
              <article class="obs-kpi">
                <p class="obs-kpi__label">% Sí</p>
                <p class="obs-kpi__value">{dashCurso.kpis.pctSi}%</p>
                <p class="obs-kpi__hint">{dashCurso.kpis.siTotal} respuestas sí/no</p>
              </article>
            )}
          </section>

          <ObservatorioCharts charts={dashCurso.charts} />

          <div class="obs-bloques">
            {dashCurso.bloques.map((b, i) => {
              const chartId = `obs-chart-act-${i}`;
              const tieneChart = dashCurso!.charts.some((chart) => chart.id === chartId);
              return (
                <article class:list={['obs-card', b.listo && 'is-ready']}>
                  <header class="obs-card__head">
                    <span class="obs-card__tipo">{etiquetaTipo(b.tipo)}</span>
                  </header>
                  <h3 class="obs-card__consigna">{b.consigna}</h3>
                  {b.listo && b.agregado ? (
                    <>
                      <p class="obs-card__meta">
                        {b.total} respuestas
                        {b.agregado.numero && ` · promedio ${b.agregado.numero.promedio.toFixed(1)}`}
                      </p>
                      {tieneChart && (
                        <div class="obs-chart-card__canvas obs-chart-card__canvas--tall">
                          <canvas id={chartId} aria-label={b.consigna}></canvas>
                        </div>
                      )}
                      {b.agregado.palabras && b.agregado.palabras.length > 0 && (
                        <ul class="obs-words">
                          {b.agregado.palabras.slice(0, 12).map((p) => (
                            <li>{p.palabra} <span>{p.cantidad}</span></li>
                          ))}
                        </ul>
                      )}
                    </>
                  ) : (
                    <>
                      <div class="obs-track" aria-hidden="true">
                        <div class="obs-fill" style={`width: ${Math.min(100, Math.round((b.total / OBS_MIN) * 100))}%`} />
                      </div>
                      <p class="obs-card__meta">{b.total}/{OBS_MIN} — todavía no hay suficientes respuestas.</p>
                    </>
                  )}
                </article>
              );
            })}
          </div>
        </>
      )}
    </section>
  </AdminChrome>
</Layout>
