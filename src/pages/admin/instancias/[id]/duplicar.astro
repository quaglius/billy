---
import Layout from '../../../../layouts/Layout.astro';
import AdminChrome from '../../../../components/AdminChrome.astro';
import AdminBreadcrumb from '../../../../components/AdminBreadcrumb.astro';
import AdminCampo from '../../../../components/AdminCampo.astro';
import { db } from '../../../../lib/firebase-admin';
import { etiquetaInstancia, migasInstancia, rutasInstancia } from '../../../../lib/admin-instancia';

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/instancias');
const doc = await db().collection('instancias').doc(id).get();
if (!doc.exists) return Astro.redirect('/admin/instancias');
const inst = doc.data()!;

const [cursosSnap, empresasSnap] = await Promise.all([
  db().collection('cursos').get(),
  db().collection('empresas').orderBy('nombre').get(),
]);
const cursoTitulo = cursosSnap.docs.find((d) => d.id === inst.cursoId)?.data().titulo;
const empresaNombre = empresasSnap.docs.find((d) => d.id === inst.empresaId)?.data().nombre;
const nombre = etiquetaInstancia(inst, cursoTitulo, empresaNombre);
const rutas = rutasInstancia(id);
const empresas = empresasSnap.docs.map((d) => ({ id: d.id, nombre: String(d.data().nombre ?? d.id) }));
const error = Astro.url.searchParams.get('error');
---
<Layout title={`Duplicar — ${nombre}`} noindex={true} whatsapp={false}>
  <AdminChrome titulo={`Duplicar ${nombre}`}>
    <AdminBreadcrumb
      slot="breadcrumb"
      crumbs={migasInstancia({ pagina: 'duplicar', instanciaId: id, instanciaLabel: nombre })}
    />
    <p class="admin-links">
      <a href={rutas.ficha}>← Instancia</a>
      <a href="/admin/instancias">Instancias</a>
    </p>
    <p>Se copia el mismo curso, con nueva empresa y fechas. Las actividades y QR son del curso, así que no hace falta duplicarlas: son las mismas de siempre.</p>
    {error && <p class="admin-alert">Faltan la empresa o la fecha de inicio.</p>}
    <form class="admin-form" method="post" action="/api/admin/instancias/duplicar">
      <input type="hidden" name="id" value={id} />
      <AdminCampo titulo="Empresa o sindicato" ayuda="La organización nueva. La copia arranca privada.">
        <select name="empresaId" required>
          <option value="">Elegí una empresa</option>
          {empresas.map((e) => (
            <option value={e.id}>{e.nombre}</option>
          ))}
        </select>
      </AdminCampo>
      <AdminCampo titulo="Fecha de inicio" ayuda="Primer día de la cursada nueva. Obligatorio.">
        <input type="date" name="fechaInicio" required />
      </AdminCampo>
      <AdminCampo titulo="Fecha de fin" ayuda="Último día previsto. Podés dejarlo vacío.">
        <input type="date" name="fechaFin" />
      </AdminCampo>
      <button type="submit">Duplicar</button>
    </form>
  </AdminChrome>
</Layout>
