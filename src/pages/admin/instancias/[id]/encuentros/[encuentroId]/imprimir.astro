---
import Layout from '../../../../../../layouts/Layout.astro';
import { db } from '../../../../../../lib/firebase-admin';

const { id, encuentroId } = Astro.params;
const actividadId = Astro.url.searchParams.get('actividad');
if (!id || !encuentroId || !actividadId) return Astro.redirect('/admin');
const act = await db().collection('actividades').doc(actividadId).get();
if (!act.exists) return Astro.redirect(`/admin/instancias/${id}`);
const a = act.data()!;
---
<Layout title="Imprimir consigna" noindex={true} whatsapp={false} chrome={false}>
  <div class="print-consigna">
    <p class="eyebrow">Consigna</p>
    <h1>{a.consigna}</h1>
    <p class="vivo__code">{a.codigo}</p>
  </div>
</Layout>
