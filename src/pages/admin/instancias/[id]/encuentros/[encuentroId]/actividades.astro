---
import Layout from '../../../../../../layouts/Layout.astro';
import AdminChrome from '../../../../../../components/AdminChrome.astro';
import AdminBreadcrumb from '../../../../../../components/AdminBreadcrumb.astro';
import AdminCampo from '../../../../../../components/AdminCampo.astro';
import { db } from '../../../../../../lib/firebase-admin';
import { etiquetaInstancia, migasInstancia, rutasInstancia } from '../../../../../../lib/admin-instancia';
import { qrDataUrl, urlParticipante, urlSitio } from '../../../../../../lib/qr';

const { id, encuentroId } = Astro.params;
if (!id || !encuentroId) return Astro.redirect('/admin/instancias');

const [enc, instDoc] = await Promise.all([
  db().collection('encuentros').doc(encuentroId).get(),
  db().collection('instancias').doc(id).get(),
]);
if (!enc.exists || !instDoc.exists) return Astro.redirect(`/admin/instancias/${id ?? ''}`);
const e = enc.data()!;
if (String(e.instanciaId) !== id) return Astro.redirect(`/admin/instancias/${id}`);

const inst = instDoc.data()!;
const nombre = etiquetaInstancia(inst);
const titulo = String(e.titulo ?? 'Encuentro');
const rutas = rutasInstancia(id, encuentroId);
const site = urlSitio(Astro.site);
const cursoId = String(inst.cursoId ?? '');

const [cursoDoc, bancoSnap] = await Promise.all([
  db().collection('cursos').doc(cursoId).get(),
  db().collection('actividades_curso').where('cursoId', '==', cursoId).orderBy('orden').get(),
]);
const cursoTitulo = cursoDoc.exists ? String(cursoDoc.data()!.titulo ?? 'este curso') : 'este curso';
const banco = bancoSnap.docs.map((d) => {
  const b = d.data();
  return { id: d.id, tipo: String(b.tipo ?? ''), consigna: String(b.consigna ?? ''), orden: Number(b.orden ?? 0) };
});

const TIPO_LABEL: Record<string, string> = {
  si_no: 'Sí / No',
  seleccion_unica: 'Opción única',
  seleccion_multiple: 'Varias opciones',
  numero: 'Número',
  fecha: 'Fecha',
  texto_libre: 'Texto libre — nube de palabras',
};

const actSnap = await db()
  .collection('actividades')
  .where('encuentroId', '==', encuentroId)
  .orderBy('orden')
  .get();

const actividades = await Promise.all(
  actSnap.docs.map(async (d) => {
    const data = d.data();
    const codigo = String(data.codigo ?? '');
    const link = urlParticipante(site, codigo);
    return {
      id: d.id,
      consigna: String(data.consigna ?? ''),
      tipo: String(data.tipo ?? ''),
      tipoLabel: TIPO_LABEL[String(data.tipo ?? '')] ?? String(data.tipo ?? ''),
      codigo,
      orden: Number(data.orden ?? 0),
      link,
      qr: await qrDataUrl(link, 420),
    };
  }),
);

const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
---
<Layout title={`Actividades — ${titulo}`} noindex={true} whatsapp={false}>
  <AdminChrome
    titulo="Actividades"
    subtitulo="Cada actividad de acá abajo ya está lista para usarse: tiene su propio QR y código, y siempre acepta respuestas — no hace falta 'activarla' antes de la charla. Cuando quieras proyectar los resultados de una en particular, tocá 'Ir en vivo' en esa tarjeta."
  >
    <AdminBreadcrumb
      slot="breadcrumb"
      crumbs={migasInstancia({
        pagina: 'actividades',
        instanciaId: id,
        instanciaLabel: nombre,
        encuentroId,
        encuentroLabel: titulo,
      })}
    />
    <p class="admin-links">
      <a href={rutas.encuentro}>← Editar encuentro</a>
    </p>
    {ok === 'importadas' && <p class="admin-ok">Actividades importadas del banco del curso.</p>}
    {ok === '1' && <p class="admin-ok">Actividad creada.</p>}
    {error === 'banco' && <p class="admin-alert">Elegí al menos una pregunta del banco para importar.</p>}
    {error === '1' && <p class="admin-alert">Falta la consigna.</p>}

    {actividades.length > 0 ? (
      <div class="act-grid">
        {actividades.map((a) => (
          <article class="act-card">
            <header class="act-card__head">
              <span class="act-card__orden">#{a.orden}</span>
              <span class="act-card__tipo">{a.tipoLabel}</span>
            </header>
            <h3 class="act-card__consigna">{a.consigna}</h3>
            <div class="act-card__join">
              <img
                class="act-card__qr-mini"
                src={a.qr}
                width="88"
                height="88"
                alt={`QR para participar: ${a.consigna}`}
                data-qr-abrir
                data-consigna={a.consigna}
                data-codigo={a.codigo}
                data-link={a.link}
                data-qr={a.qr}
              />
              <div>
                <p class="act-card__codigo">{a.codigo}</p>
                <p class="act-card__url">{a.link.replace(/^https?:\/\//, '')}</p>
              </div>
            </div>
            <div class="act-card__acciones">
              <button
                type="button"
                class="admin-btn-secondary"
                data-qr-abrir
                data-consigna={a.consigna}
                data-codigo={a.codigo}
                data-link={a.link}
                data-qr={a.qr}
              >
                Ver QR grande
              </button>
              <button
                type="button"
                class="admin-btn-secondary"
                data-qr-descargar
                data-consigna={a.consigna}
                data-codigo={a.codigo}
                data-link={a.link}
                data-qr={a.qr}
              >
                Descargar QR
              </button>
              <a class="admin-btn-primario" href={rutas.vivoDe(a.id)}>Ir en vivo</a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p>No hay actividades todavía. Cargá la primera con el formulario de abajo.</p>
    )}

    <h2>Importar del banco de {cursoTitulo}</h2>
    <p class="admin-section-nota">
      Las preguntas que ya cargaste una vez para este curso. Elegí las que quieras usar en este
      encuentro — cada una se copia con su propio código y QR nuevo, así que las respuestas de esta
      cursada nunca se mezclan con las de otra instancia que use las mismas preguntas.
    </p>
    {banco.length === 0 ? (
      <p class="admin-section-nota">
        Todavía no hay preguntas en el banco de {cursoTitulo}. Cargalas desde
        {' '}<a href={`/admin/cursos/${cursoId}`}>la ficha del curso</a>, así quedan disponibles para esta
        instancia y para las próximas.
      </p>
    ) : (
      <form class="admin-form banco-form" method="post" action="/api/admin/actividades/importar">
        <input type="hidden" name="encuentroId" value={encuentroId} />
        <input type="hidden" name="instanciaId" value={id} />
        <fieldset class="banco-lista">
          {banco.map((b) => (
            <label class="banco-item">
              <input type="checkbox" name="banco" value={b.id} />
              <span class="banco-item__tipo">{TIPO_LABEL[b.tipo] ?? b.tipo}</span>
              <span>{b.consigna}</span>
            </label>
          ))}
        </fieldset>
        <button type="submit">Copiar seleccionadas a este encuentro</button>
      </form>
    )}

    <h2>Actividad puntual para este encuentro</h2>
    <p class="admin-section-nota">
      Para una pregunta que solo tiene sentido acá y no querés guardar en el banco del curso. Se
      crea lista para usar: apenas la guardés, ya tiene su código y su QR.
    </p>
    <form class="admin-form" method="post" action="/api/admin/actividades">
      <input type="hidden" name="encuentroId" value={encuentroId} />
      <input type="hidden" name="instanciaId" value={id} />
      <AdminCampo titulo="Orden" ayuda="El orden en que vas a pasar las consignas en vivo. 1 es la primera.">
        <input type="number" name="orden" value={actividades.length + 1} required />
      </AdminCampo>
      <AdminCampo
        titulo="Tipo"
        ayuda="Sí/No: dos botones grandes. Opción única: una sola respuesta. Varias opciones: puede marcar más de una. Número o fecha: un valor. Texto libre: arma una nube de palabras con lo que escribe la gente."
      >
        <select name="tipo">
          <option value="si_no">Sí / No</option>
          <option value="seleccion_unica">Opción única — una sola respuesta</option>
          <option value="seleccion_multiple">Varias opciones — puede marcar más de una</option>
          <option value="numero">Número</option>
          <option value="fecha">Fecha</option>
          <option value="texto_libre">Texto libre — nube de palabras</option>
        </select>
      </AdminCampo>
      <AdminCampo titulo="Consigna" ayuda="La pregunta que ve la gente en el celular. En primera persona, clara, sin jerga.">
        <textarea name="consigna" rows="3" required></textarea>
      </AdminCampo>
      <AdminCampo titulo="Opciones" ayuda="Solo para opción única o varias opciones: una por línea. En Sí/No, número, fecha o texto libre, dejalo vacío.">
        <textarea name="opciones" rows="4"></textarea>
      </AdminCampo>
      <button type="submit">Crear</button>
    </form>
  </AdminChrome>

  <dialog id="qr-dialog" class="qr-dialog">
    <button type="button" class="qr-dialog__cerrar" data-qr-cerrar aria-label="Cerrar">✕</button>
    <img id="qr-dialog-img" class="qr-dialog__img" alt="" />
    <p id="qr-dialog-consigna" class="qr-dialog__consigna"></p>
    <p id="qr-dialog-codigo" class="qr-dialog__codigo"></p>
    <p id="qr-dialog-url" class="qr-dialog__url"></p>
  </dialog>
</Layout>

<script>
  const dialog = document.getElementById('qr-dialog') as HTMLDialogElement | null;
  const dImg = document.getElementById('qr-dialog-img') as HTMLImageElement | null;
  const dConsigna = document.getElementById('qr-dialog-consigna');
  const dCodigo = document.getElementById('qr-dialog-codigo');
  const dUrl = document.getElementById('qr-dialog-url');

  document.querySelectorAll<HTMLElement>('[data-qr-abrir]').forEach((el) => {
    el.addEventListener('click', () => {
      if (!dialog || !dImg) return;
      dImg.src = el.dataset.qr ?? '';
      dImg.alt = `QR para participar: ${el.dataset.consigna ?? ''}`;
      if (dConsigna) dConsigna.textContent = el.dataset.consigna ?? '';
      if (dCodigo) dCodigo.textContent = el.dataset.codigo ?? '';
      if (dUrl) dUrl.textContent = (el.dataset.link ?? '').replace(/^https?:\/\//, '');
      dialog.showModal();
    });
  });

  document.querySelectorAll('[data-qr-cerrar]').forEach((el) => {
    el.addEventListener('click', () => dialog?.close());
  });
  dialog?.addEventListener('click', (ev) => {
    if (ev.target === dialog) dialog.close();
  });

  function wrapText(ctx: CanvasRenderingContext2D, texto: string, maxWidth: number): string[] {
    const palabras = texto.split(/\s+/);
    const lineas: string[] = [];
    let actual = '';
    for (const palabra of palabras) {
      const prueba = actual ? `${actual} ${palabra}` : palabra;
      if (ctx.measureText(prueba).width > maxWidth && actual) {
        lineas.push(actual);
        actual = palabra;
      } else {
        actual = prueba;
      }
    }
    if (actual) lineas.push(actual);
    return lineas;
  }

  async function descargar(el: HTMLElement) {
    const qrSrc = el.dataset.qr ?? '';
    const consigna = el.dataset.consigna ?? '';
    const codigo = el.dataset.codigo ?? '';
    const link = (el.dataset.link ?? '').replace(/^https?:\/\//, '');
    if (!qrSrc) return;

    const img = new Image();
    img.src = qrSrc;
    await new Promise((resolve, reject) => {
      img.onload = resolve;
      img.onerror = reject;
    });

    const W = 1080;
    const H = 1350;
    const canvas = document.createElement('canvas');
    canvas.width = W;
    canvas.height = H;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.fillStyle = '#051229';
    ctx.fillRect(0, 0, W, H);

    ctx.fillStyle = '#0075ff';
    ctx.font = '700 32px Lato, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('PARTICIPÁ', W / 2, 110);

    ctx.fillStyle = '#ffffff';
    ctx.font = '600 46px "Libre Franklin", sans-serif';
    const lineas = wrapText(ctx, consigna, W - 160).slice(0, 4);
    let y = 200;
    for (const linea of lineas) {
      ctx.fillText(linea, W / 2, y);
      y += 58;
    }

    const qrSize = 640;
    const qrX = (W - qrSize) / 2;
    const qrY = Math.max(y + 40, 420);
    const pad = 32;
    ctx.fillStyle = '#ffffff';
    const r = 24;
    const bx = qrX - pad;
    const by = qrY - pad;
    const bw = qrSize + pad * 2;
    const bh = qrSize + pad * 2;
    ctx.beginPath();
    ctx.moveTo(bx + r, by);
    ctx.arcTo(bx + bw, by, bx + bw, by + bh, r);
    ctx.arcTo(bx + bw, by + bh, bx, by + bh, r);
    ctx.arcTo(bx, by + bh, bx, by, r);
    ctx.arcTo(bx, by, bx + bw, by, r);
    ctx.closePath();
    ctx.fill();
    ctx.drawImage(img, qrX, qrY, qrSize, qrSize);

    const codeY = by + bh + 90;
    ctx.fillStyle = '#0075ff';
    ctx.font = '700 64px "Libre Franklin", sans-serif';
    ctx.fillText(codigo, W / 2, codeY);

    ctx.fillStyle = '#a9b0b8';
    ctx.font = '400 26px Lato, sans-serif';
    ctx.fillText(link, W / 2, codeY + 50);

    canvas.toBlob((blob) => {
      if (!blob) return;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${codigo}-qr.png`;
      a.click();
      URL.revokeObjectURL(url);
    }, 'image/png');
  }

  document.querySelectorAll<HTMLElement>('[data-qr-descargar]').forEach((el) => {
    el.addEventListener('click', () => descargar(el));
  });
</script>
