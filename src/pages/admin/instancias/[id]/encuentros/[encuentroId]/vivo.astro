---
import Layout from '../../../../../../layouts/Layout.astro';
import AdminBreadcrumb from '../../../../../../components/AdminBreadcrumb.astro';
import { db } from '../../../../../../lib/firebase-admin';
import { etiquetaInstancia, migasInstancia, rutasInstancia } from '../../../../../../lib/admin-instancia';
import { qrDataUrl, urlParticipante, urlSitio } from '../../../../../../lib/qr';

const { id, encuentroId } = Astro.params;
if (!id || !encuentroId) return Astro.redirect('/admin/instancias');

const [enc, instDoc] = await Promise.all([
  db().collection('encuentros').doc(encuentroId).get(),
  db().collection('instancias').doc(id).get(),
]);
if (!enc.exists || !instDoc.exists) return Astro.redirect('/admin/instancias');
const e = enc.data()!;
if (String(e.instanciaId) !== id) return Astro.redirect(`/admin/instancias/${id}`);

const nombre = etiquetaInstancia(instDoc.data()!);
const titulo = String(e.titulo ?? 'Encuentro');
const rutas = rutasInstancia(id, encuentroId);
const site = urlSitio(Astro.site);

const actSnap = await db()
  .collection('actividades')
  .where('encuentroId', '==', encuentroId)
  .orderBy('orden')
  .get();
const actividades = actSnap.docs.map((d) => {
  const data = d.data();
  return {
    id: d.id,
    consigna: String(data.consigna ?? ''),
    codigo: String(data.codigo ?? ''),
    tipo: String(data.tipo ?? ''),
    orden: Number(data.orden ?? 0),
  };
});

const actividadIdParam = Astro.url.searchParams.get('actividad') ?? '';
const actual = actividades.find((a) => a.id === actividadIdParam) ?? null;

let qr = '';
let link = '';
if (actual) {
  link = urlParticipante(site, actual.codigo);
  qr = await qrDataUrl(link, 480);
}

const otras = actual ? actividades.filter((a) => a.id !== actual.id) : [];
---
<Layout title={actual ? `En vivo — ${actual.consigna}` : 'En vivo'} noindex={true} whatsapp={false} chrome={false}>
  <div class="vivo">
    <header class="vivo__bar">
      <AdminBreadcrumb
        tone="vivo"
        crumbs={migasInstancia({
          pagina: 'vivo',
          instanciaId: id,
          instanciaLabel: nombre,
          encuentroId,
          encuentroLabel: titulo,
        })}
      />
      <div class="vivo__bar-acciones">
        <a href={rutas.actividades}>Todas las actividades</a>
        <a href={rutas.encuentro}>Editar</a>
        {actual && <a href={rutas.imprimirDe(actual.id)} target="_blank">Imprimir</a>}
      </div>
    </header>

    {actual ? (
      <div class="vivo__stage">
        <aside class="vivo__join">
          <img class="vivo__qr-img" src={qr} width="360" height="360" alt={`QR para participar: ${actual.consigna}`} />
          <p class="vivo__hint">Escaneá o entrá con el código</p>
          <p class="vivo__code">{actual.codigo}</p>
          <p class="vivo__url">{link.replace(/^https?:\/\//, '')}</p>
        </aside>
        <section class="vivo__board">
          <p class="vivo__eyebrow">En vivo</p>
          <h1 class="vivo__pregunta">{actual.consigna}</h1>
          <div id="grafico" class="vivo__grafico" data-actividad={actual.id} data-tipo={actual.tipo}>
            <p class="vivo__esperando">Esperando respuestas…</p>
          </div>
          {otras.length > 0 && (
            <div class="vivo__acciones">
              <label class="vivo__selector">
                Cambiar de actividad
                <select id="selector-actividad">
                  <option value="">Elegir…</option>
                  {otras.map((o) => (
                    <option value={rutas.vivoDe(o.id)}>#{o.orden} · {o.consigna.slice(0, 60)}</option>
                  ))}
                </select>
              </label>
            </div>
          )}
        </section>
      </div>
    ) : (
      <div class="vivo__picker">
        <h1>¿Qué actividad querés proyectar?</h1>
        <p class="vivo__picker-ayuda">
          Todas están siempre listas para responder. Elegí cuál mostrar en pantalla — podés cambiar
          de una a otra en cualquier momento, sin perder las respuestas de las demás.
        </p>
        {actividades.length === 0 ? (
          <p>Todavía no cargaste actividades para este encuentro. <a href={rutas.actividades}>Cargá la primera acá</a>.</p>
        ) : (
          <div class="vivo__picker-grid">
            {actividades.map((a) => (
              <a class="vivo__picker-card" href={rutas.vivoDe(a.id)}>
                <span class="vivo__picker-orden">#{a.orden}</span>
                <span>{a.consigna}</span>
              </a>
            ))}
          </div>
        )}
      </div>
    )}
  </div>
</Layout>

<script>
  const selector = document.getElementById('selector-actividad') as HTMLSelectElement | null;
  selector?.addEventListener('change', () => {
    if (selector.value) window.location.href = selector.value;
  });
</script>

{actual && (
  <script>
    const el = document.getElementById('grafico');
    if (el) {
      const idAct = el.dataset.actividad;
      let ultimo = '';

      const PALETA = ['#0075ff', '#051229', '#364052', '#7e8590'];

      function barra(etiqueta, porcentaje) {
        const row = document.createElement('div');
        row.className = 'vivo-bar';
        const head = document.createElement('div');
        head.className = 'vivo-bar__head';
        const name = document.createElement('strong');
        name.textContent = etiqueta;
        const pct = document.createElement('span');
        pct.textContent = `${porcentaje}%`;
        head.append(name, pct);
        const track = document.createElement('div');
        track.className = 'vivo-bar__track';
        const fill = document.createElement('div');
        fill.className = 'vivo-bar__fill';
        fill.style.width = `${porcentaje}%`;
        track.append(fill);
        row.append(head, track);
        return row;
      }

      function nube(palabras) {
        const max = Math.max(...palabras.map((p) => p.cantidad), 1);
        const min = Math.min(...palabras.map((p) => p.cantidad), 1);
        const wrap = document.createElement('div');
        wrap.className = 'vivo-nube';
        palabras.forEach((p, i) => {
          const span = document.createElement('span');
          span.className = 'vivo-nube__palabra';
          const escala = max === min ? 0.6 : (p.cantidad - min) / (max - min);
          const tamano = 20 + escala * 64;
          span.style.fontSize = `${tamano}px`;
          span.style.color = PALETA[i % PALETA.length === 1 ? 1 : 0];
          span.style.opacity = String(0.55 + escala * 0.45);
          const giro = ((i * 37) % 11) - 5;
          span.style.transform = `rotate(${giro}deg)`;
          span.textContent = p.palabra;
          wrap.append(span);
        });
        return wrap;
      }

      async function tick() {
        try {
          const res = await fetch(`/api/actividad/${idAct}/resultados`);
          if (!res.ok) return;
          const data = await res.json();
          const serial = JSON.stringify(data);
          if (serial === ultimo) return;
          ultimo = serial;
          el.replaceChildren();
          if (data.barras) {
            data.barras.forEach((b) => el.append(barra(String(b.etiqueta), Number(b.porcentaje))));
          } else if (data.numero) {
            const wrap = document.createElement('div');
            wrap.className = 'vivo-num';
            wrap.innerHTML =
              `<p class="vivo-num__big">${data.numero.promedio.toFixed(1)}</p><p>promedio · mín ${data.numero.min} · máx ${data.numero.max}</p>`;
            el.append(wrap);
          } else if (data.palabras && data.palabras.length) {
            el.append(nube(data.palabras));
          } else if (data.semanas) {
            data.semanas.forEach((s) => el.append(barra(String(s.semana), Number(s.cantidad))));
          } else {
            const p = document.createElement('p');
            p.className = 'vivo__esperando';
            p.textContent = 'Todavía no hay respuestas.';
            el.append(p);
          }
        } catch {
          /* último dato visible */
        }
      }
      tick();
      setInterval(tick, 2000);
    }
  </script>
)}
