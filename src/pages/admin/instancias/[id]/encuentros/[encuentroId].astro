---
import Layout from '../../../../../layouts/Layout.astro';
import AdminChrome from '../../../../../components/AdminChrome.astro';
import AdminBreadcrumb from '../../../../../components/AdminBreadcrumb.astro';
import AdminCampo from '../../../../../components/AdminCampo.astro';
import { db } from '../../../../../lib/firebase-admin';
import { fechaDeDoc, toDatetimeLocal } from '../../../../../lib/encuentro';
import { etiquetaInstancia, migasInstancia, rutasInstancia } from '../../../../../lib/admin-instancia';

const { id, encuentroId } = Astro.params;
if (!id || !encuentroId) return Astro.redirect('/admin/instancias');

const [enc, instDoc] = await Promise.all([
  db().collection('encuentros').doc(encuentroId).get(),
  db().collection('instancias').doc(id).get(),
]);
if (!enc.exists || !instDoc.exists) return Astro.redirect('/admin/instancias');
const e = enc.data()!;
if (String(e.instanciaId) !== id) return Astro.redirect(`/admin/instancias/${id}`);

const inst = instDoc.data()!;
const nombre = etiquetaInstancia(inst);
const titulo = String(e.titulo ?? 'Encuentro');
const fechaHora = fechaDeDoc(e.fechaHora);
const rutas = rutasInstancia(id, encuentroId);
const archivado = Boolean(e.archivado);
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const mensajesOk: Record<string, string> = {
  '1': 'Cambios guardados.',
  creado: 'Encuentro creado.',
};
const cursoId = String(inst.cursoId ?? '');
---
<Layout title={`Editar — ${titulo}`} noindex={true} whatsapp={false}>
  <AdminChrome titulo={titulo}>
    <AdminBreadcrumb
      slot="breadcrumb"
      crumbs={migasInstancia({
        pagina: 'encuentro',
        instanciaId: id,
        instanciaLabel: nombre,
        encuentroId,
        encuentroLabel: titulo,
      })}
    />
    {ok && mensajesOk[ok] && <p class="admin-ok">{mensajesOk[ok]}</p>}
    {error && <p class="admin-alert">Faltan el título o la fecha.</p>}
    {archivado && <p class="admin-alert">Este encuentro está archivado. No aparece en el cronograma hasta que lo restaures.</p>}

    <p class="admin-links">
      <a href={rutas.cronograma}>← Cronograma</a>
      <a href={`/admin/cursos/${cursoId}`}>Ver preguntas y QRs de este curso →</a>
    </p>
    <p class="admin-section-nota">
      Las preguntas y los QR ya no se cargan por encuentro: viven en el curso, con código fijo
      para siempre. Este encuentro es solo la fecha del cronograma — para proyectar en vivo,
      andá a la ficha del curso y tocá "Ir en vivo" en la pregunta que quieras.
    </p>

    <h2>Editar encuentro</h2>
    <form class="admin-form" method="post" action="/api/admin/encuentros">
      <input type="hidden" name="instanciaId" value={id} />
      <input type="hidden" name="id" value={encuentroId} />
      <input type="hidden" name="_action" value="guardar" />
      <AdminCampo titulo="Orden" ayuda="Número de aparición en el cronograma. 1 es el primero.">
        <input type="number" name="orden" value={Number(e.orden ?? 1)} required />
      </AdminCampo>
      <AdminCampo titulo="Título" ayuda="Cómo se llama este encuentro en el cronograma y en la pantalla en vivo.">
        <input type="text" name="titulo" value={titulo} required />
      </AdminCampo>
      <AdminCampo titulo="Fecha y hora" ayuda="Cuándo empieza. El estado (próximo / en curso / completado) se calcula solo.">
        <input type="datetime-local" name="fechaHora" value={toDatetimeLocal(fechaHora)} required />
      </AdminCampo>
      <AdminCampo titulo="Duración (minutos)" ayuda="Cuánto dura la sesión. Si está vacío, se asumen 120 minutos.">
        <input type="number" name="duracionMinutos" value={e.duracionMinutos ?? 120} />
      </AdminCampo>
      <AdminCampo titulo="Descripción" ayuda="Qué se trabaja ese día. Opcional.">
        <textarea name="descripcion" rows="4">{e.descripcion ?? ''}</textarea>
      </AdminCampo>
      <button type="submit">Guardar cambios</button>
    </form>

    <section class="admin-danger">
      <h2>Archivar o eliminar</h2>
      <p>Archivar lo saca del cronograma y se puede volver atrás. Eliminar borra solo esta fecha — las preguntas y el historial de respuestas están en el curso y no se tocan.</p>
      <div class="admin-danger__acciones">
        <form method="post" action="/api/admin/encuentros">
          <input type="hidden" name="instanciaId" value={id} />
          <input type="hidden" name="id" value={encuentroId} />
          <input type="hidden" name="_action" value={archivado ? 'restaurar' : 'archivar'} />
          <button class="admin-btn-secondary" type="submit">{archivado ? 'Restaurar al cronograma' : 'Archivar'}</button>
        </form>
        <form
          method="post"
          action="/api/admin/encuentros"
          onsubmit="return confirm('Se van a borrar este encuentro y sus actividades. ¿Continuar?');"
        >
          <input type="hidden" name="instanciaId" value={id} />
          <input type="hidden" name="id" value={encuentroId} />
          <input type="hidden" name="_action" value="eliminar" />
          <button class="admin-btn-danger" type="submit">Eliminar</button>
        </form>
      </div>
    </section>
  </AdminChrome>
</Layout>
