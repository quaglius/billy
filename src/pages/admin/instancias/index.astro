---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import AdminBreadcrumb from '../../../components/AdminBreadcrumb.astro';
import ObservatorioCharts from '../../../components/ObservatorioCharts.astro';
import { db } from '../../../lib/firebase-admin';
import AdminCampo from '../../../components/AdminCampo.astro';
import { etiquetaInstancia, migasInstancia } from '../../../lib/admin-instancia';
import { fechaDeDoc } from '../../../lib/encuentro';
import { ultimosNMeses } from '../../../lib/kpis';
import type { ChartSpec } from '../../../lib/observatorio';

let instancias: {
  id: string;
  slug: string;
  nombre: string;
  cursoId: string;
  empresaId: string;
  creadoEn: Date;
}[] = [];
let cursos = new Map<string, string>();
let empresas = new Map<string, string>();
let errorCarga = '';
try {
  const [instSnap, cursoSnap, empSnap] = await Promise.all([
    db().collection('instancias').get(),
    db().collection('cursos').get(),
    db().collection('empresas').get(),
  ]);
  cursoSnap.docs.forEach((d) => cursos.set(d.id, String(d.data().titulo ?? d.id)));
  empSnap.docs.forEach((d) => empresas.set(d.id, String(d.data().nombre ?? d.id)));
  instancias = instSnap.docs.map((d) => {
    const data = d.data();
    return {
      id: d.id,
      slug: String(data.slug ?? ''),
      nombre: etiquetaInstancia(data),
      cursoId: String(data.cursoId ?? ''),
      empresaId: String(data.empresaId ?? ''),
      creadoEn: fechaDeDoc(data.creadoEn),
    };
  });
} catch (err) {
  errorCarga = err instanceof Error ? err.message : 'No se pudieron leer las instancias.';
}

const kpiTotal = instancias.length;
const inicioMes = new Date();
inicioMes.setDate(1);
inicioMes.setHours(0, 0, 0, 0);
const kpiEsteMes = instancias.filter((i) => i.creadoEn >= inicioMes).length;

const meses = ultimosNMeses(6);
const porMes = meses.map((m) => instancias.filter((i) => m.pertenece(i.creadoEn)).length);

const charts: ChartSpec[] = [];
if (kpiTotal > 0) {
  charts.push({
    id: 'inst-chart-mes',
    tipo: 'line',
    titulo: 'Instancias creadas por mes',
    labels: meses.map((m) => m.etiqueta),
    values: porMes,
  });
}
---
<Layout title="Instancias — Admin" noindex={true} whatsapp={false}>
  <AdminChrome
    titulo="Instancias"
    subtitulo="Una instancia es un curso dictado a una empresa concreta, con fechas reales. Acá también gestionás el cronograma de encuentros y las actividades de cada una. Son siempre privadas: solo entra quien tiene el link o el QR, nunca aparecen listadas en el sitio."
  >
    <AdminBreadcrumb slot="breadcrumb" crumbs={migasInstancia({ pagina: 'listado' })} />
    {errorCarga && <p class="admin-alert">{errorCarga}</p>}
    {Astro.url.searchParams.get('ok') && <p class="admin-ok">Instancia creada.</p>}
    {Astro.url.searchParams.get('error') === 'slug' && <p class="admin-alert">Ese slug ya está en uso.</p>}
    {Astro.url.searchParams.get('error') === '1' && <p class="admin-alert">Faltan curso, empresa o slug.</p>}

    {kpiTotal > 0 && (
      <>
        <section class="obs-kpis" aria-label="Indicadores de instancias">
          <article class="obs-kpi">
            <p class="obs-kpi__label">Total</p>
            <p class="obs-kpi__value">{kpiTotal}</p>
            <p class="obs-kpi__hint">Instancias cargadas en total</p>
          </article>
          <article class="obs-kpi">
            <p class="obs-kpi__label">Este mes</p>
            <p class="obs-kpi__value">{kpiEsteMes}</p>
            <p class="obs-kpi__hint">Instancias nuevas desde el 1°</p>
          </article>
        </section>
        <ObservatorioCharts charts={charts} />
      </>
    )}

    {instancias.length > 0 && (
      <div data-table-wrap>
        <div class="admin-table-tools">
          <input type="search" class="admin-search" data-table-search placeholder="Buscar por instancia, curso o empresa…" aria-label="Buscar instancia" />
          <span class="admin-table-count" data-table-count></span>
        </div>
        <table class="admin-table" data-admin-table data-page-size="20">
          <thead>
            <tr><th data-sort="text">Instancia</th><th data-sort="text">Curso</th><th data-sort="text">Empresa</th><th>Acciones</th></tr>
          </thead>
          <tbody>
            {instancias.map((i) => (
              <tr>
                <td class="admin-table__titulo">
                  <a href={`/admin/instancias/${i.id}`}>{i.nombre}</a>
                </td>
                <td>{cursos.get(i.cursoId) ?? i.cursoId}</td>
                <td>{empresas.get(i.empresaId) ?? i.empresaId}</td>
                <td class="admin-table__acciones">
                  <a href={`/admin/instancias/${i.id}`}>Cronograma</a>
                  <a href={`/admin/instancias/${i.id}/duplicar`}>Duplicar</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <nav class="admin-pager" data-pager aria-label="Paginado de instancias"></nav>
      </div>
    )}
    {instancias.length === 0 && !errorCarga && <p>No hay instancias todavía. Cargá la primera con el formulario de abajo.</p>}

    <h2>Nueva instancia</h2>
    <form class="admin-form" method="post" action="/api/admin/instancias">
      <AdminCampo titulo="Curso" ayuda="Elegí el formato-tipo que se va a dictar: Encuentro, Taller o Programa. Es la plantilla; esta instancia es esa cursada para una organización concreta.">
        <select name="cursoId" required>
          {Array.from(cursos.entries()).map(([id, titulo]) => (
            <option value={id}>{titulo}</option>
          ))}
        </select>
      </AdminCampo>
      <AdminCampo titulo="Empresa" ayuda="Organización, sindicato o área para la que se arma esta cursada. Si no está en la lista, cargala antes en Empresas.">
        <select name="empresaId" required>
          {Array.from(empresas.entries()).map(([id, nombre]) => (
            <option value={id}>{nombre}</option>
          ))}
        </select>
      </AdminCampo>
      <AdminCampo titulo="Slug público" ayuda="La parte de la URL, en minúsculas y con guiones. Ejemplo: taller-sitos-2026. Tiene que ser único. No uses espacios ni tildes.">
        <input type="text" name="slug" required placeholder="taller-sitos-2026" />
      </AdminCampo>
      <AdminCampo
        titulo="Modalidad"
        ayuda="Presencial: en el lugar de trabajo. Virtual: por videollamada. Híbrida: parte en sala y parte conectada. Si todavía no está definido, dejá “Sin definir”."
      >
        <select name="modalidad">
          <option value="">Sin definir</option>
          <option value="presencial">Presencial</option>
          <option value="virtual">Virtual</option>
          <option value="hibrida">Híbrida</option>
        </select>
      </AdminCampo>
      <AdminCampo titulo="Fecha inicio" ayuda="Primer día de esta cursada. Se usa para ordenar y para el cronograma.">
        <input type="date" name="fechaInicio" />
      </AdminCampo>
      <AdminCampo titulo="Fecha fin" ayuda="Último día previsto. En un encuentro de un solo día puede coincidir con el inicio. Podés dejarlo vacío y completarlo después.">
        <input type="date" name="fechaFin" />
      </AdminCampo>
      <button type="submit">Crear</button>
    </form>
  </AdminChrome>
</Layout>

<script src="/admin/table-utils.js" defer></script>
