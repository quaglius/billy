---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import AdminCampo from '../../../components/AdminCampo.astro';
import RubroSelect from '../../../components/RubroSelect.astro';
import ImagePicker from '../../../components/ImagePicker.astro';
import ObservatorioCharts from '../../../components/ObservatorioCharts.astro';
import { db } from '../../../lib/firebase-admin';
import { fechaDeDoc } from '../../../lib/encuentro';
import { ultimosNMeses } from '../../../lib/kpis';
import type { ChartSpec } from '../../../lib/observatorio';

let empresas: { id: string; nombre: string; slug: string; rubro: string; creadoEn: Date }[] = [];
let instanciasPorEmpresa = new Map<string, number>();
let errorCarga = '';
try {
  const [snap, instSnap] = await Promise.all([
    db().collection('empresas').orderBy('nombre').get(),
    db().collection('instancias').get(),
  ]);
  empresas = snap.docs.map((d) => {
    const data = d.data();
    return {
      id: d.id,
      nombre: String(data.nombre ?? ''),
      slug: String(data.slug ?? ''),
      rubro: String(data.rubro ?? '') || 'Sin definir',
      creadoEn: fechaDeDoc(data.creadoEn),
    };
  });
  instSnap.docs.forEach((d) => {
    const empId = String(d.data().empresaId ?? '');
    instanciasPorEmpresa.set(empId, (instanciasPorEmpresa.get(empId) ?? 0) + 1);
  });
} catch (err) {
  errorCarga = err instanceof Error ? err.message : 'No se pudieron leer las empresas.';
}

const kpiTotal = empresas.length;
const kpiConInstancias = empresas.filter((e) => (instanciasPorEmpresa.get(e.id) ?? 0) > 0).length;
const inicioMes = new Date();
inicioMes.setDate(1);
inicioMes.setHours(0, 0, 0, 0);
const kpiEsteMes = empresas.filter((e) => e.creadoEn >= inicioMes).length;

const porRubro = new Map<string, number>();
empresas.forEach((e) => porRubro.set(e.rubro, (porRubro.get(e.rubro) ?? 0) + 1));
const rubrosTop = [...porRubro.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const meses = ultimosNMeses(6);
const porMes = meses.map((m) => empresas.filter((e) => m.pertenece(e.creadoEn)).length);

const charts: ChartSpec[] = [];
if (kpiTotal > 0) {
  if (rubrosTop.length > 1) {
    charts.push({
      id: 'emp-chart-rubro',
      tipo: 'bar',
      titulo: 'Por rubro',
      labels: rubrosTop.map(([r]) => r),
      values: rubrosTop.map(([, n]) => n),
      horizontal: true,
    });
  }
  charts.push({
    id: 'emp-chart-mes',
    tipo: 'line',
    titulo: 'Empresas cargadas por mes',
    labels: meses.map((m) => m.etiqueta),
    values: porMes,
  });
}
---
<Layout title="Empresas — Admin" noindex={true} whatsapp={false}>
  <AdminChrome
    titulo="Empresas"
    subtitulo="Las organizaciones, sindicatos o áreas para las que dictás cada curso. Cargalas acá antes de crear una Instancia — los datos de contacto y las notas internas solo se ven en este panel, nunca en el sitio público."
  >
    {Astro.url.searchParams.get('ok') && <p class="admin-ok">Empresa creada.</p>}
    {Astro.url.searchParams.get('error') && <p class="admin-alert">Falta el nombre.</p>}
    {errorCarga && <p class="admin-alert">{errorCarga}</p>}

    {kpiTotal > 0 && (
      <>
        <section class="obs-kpis" aria-label="Indicadores de empresas">
          <article class="obs-kpi">
            <p class="obs-kpi__label">Total</p>
            <p class="obs-kpi__value">{kpiTotal}</p>
            <p class="obs-kpi__hint">Empresas cargadas en total</p>
          </article>
          <article class="obs-kpi">
            <p class="obs-kpi__label">Con instancias</p>
            <p class="obs-kpi__value">{kpiConInstancias}</p>
            <p class="obs-kpi__hint">Ya tienen al menos una cursada</p>
          </article>
          <article class="obs-kpi">
            <p class="obs-kpi__label">Este mes</p>
            <p class="obs-kpi__value">{kpiEsteMes}</p>
            <p class="obs-kpi__hint">Empresas nuevas desde el 1°</p>
          </article>
        </section>
        <ObservatorioCharts charts={charts} />
      </>
    )}

    {empresas.length > 0 && (
      <div data-table-wrap>
        <div class="admin-table-tools">
          <input type="search" class="admin-search" data-table-search placeholder="Buscar empresa…" aria-label="Buscar empresa" />
          <span class="admin-table-count" data-table-count></span>
        </div>
        <table class="admin-table" data-admin-table data-page-size="20">
          <thead>
            <tr><th data-sort="text">Nombre</th><th data-sort="text">Slug</th><th></th></tr>
          </thead>
          <tbody>
            {empresas.map((e) => (
              <tr>
                <td class="admin-table__titulo"><a href={`/admin/empresas/${e.id}`}>{e.nombre}</a></td>
                <td>{e.slug}</td>
                <td><a href={`/admin/empresas/${e.id}`}>Editar</a></td>
              </tr>
            ))}
          </tbody>
        </table>
        <nav class="admin-pager" data-pager aria-label="Paginado de empresas"></nav>
      </div>
    )}
    {empresas.length === 0 && !errorCarga && <p>No hay empresas todavía. Cargá la primera con el formulario de abajo.</p>}

    <h2>Nueva empresa</h2>
    <form class="admin-form" method="post" action="/api/admin/empresas">
      <AdminCampo titulo="Nombre" ayuda="Cómo figura la organización en el panel. No se publica si la instancia es privada o anonimizada.">
        <input type="text" name="nombre" required />
      </AdminCampo>
      <AdminCampo titulo="Rubro" ayuda="Sector o actividad, para tu orden interno. Si no está en la lista, elegí «Otro…» y escribilo.">
        <RubroSelect />
      </AdminCampo>
      <AdminCampo titulo="Logo" ayuda="Solo se muestra si algún día decidís hacer pública esta empresa (por defecto todo queda privado). Opcional.">
        <ImagePicker id="empresa-nueva" name="logoUrl" />
      </AdminCampo>
      <AdminCampo titulo="Contacto" ayuda="Nombre de la persona de referencia (RRHH, delegado, etc.). Solo lo ves vos.">
        <input type="text" name="contactoNombre" />
      </AdminCampo>
      <AdminCampo titulo="Email" ayuda="Interno: nunca se muestra en el sitio. Sirve para que vos sepas a quién escribir.">
        <input type="email" name="contactoEmail" />
      </AdminCampo>
      <AdminCampo titulo="Teléfono" ayuda="Interno: nunca se muestra en el sitio.">
        <input type="text" name="contactoTelefono" />
      </AdminCampo>
      <AdminCampo titulo="Notas internas" ayuda="Recordatorios para vos: cómo se llegó a esta organización, acuerdos, lo que no conviene olvidar.">
        <textarea name="notasInternas" rows="3"></textarea>
      </AdminCampo>
      <button type="submit">Crear</button>
    </form>
  </AdminChrome>
</Layout>

<script src="/admin/table-utils.js" defer></script>
