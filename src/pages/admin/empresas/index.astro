---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import AdminCampo from '../../../components/AdminCampo.astro';
import { db } from '../../../lib/firebase-admin';

let empresas: { id: string; nombre: string; slug: string }[] = [];
let errorCarga = '';
try {
  const snap = await db().collection('empresas').orderBy('nombre').get();
  empresas = snap.docs.map((d) => ({
    id: d.id,
    nombre: String(d.data().nombre ?? ''),
    slug: String(d.data().slug ?? ''),
  }));
} catch (err) {
  errorCarga = err instanceof Error ? err.message : 'No se pudieron leer las empresas.';
}
---
<Layout title="Empresas — Admin" noindex={true} whatsapp={false}>
  <AdminChrome
    titulo="Empresas"
    subtitulo="Las organizaciones, sindicatos o áreas para las que dictás cada curso. Cargalas acá antes de crear una Instancia — los datos de contacto y las notas internas solo se ven en este panel, nunca en el sitio público."
  >
    {Astro.url.searchParams.get('ok') && <p class="admin-ok">Empresa creada.</p>}
    {Astro.url.searchParams.get('error') && <p class="admin-alert">Falta el nombre.</p>}
    {errorCarga && <p class="admin-alert">{errorCarga}</p>}
    {empresas.length > 0 && (
      <div data-table-wrap>
        <div class="admin-table-tools">
          <input type="search" class="admin-search" data-table-search placeholder="Buscar empresa…" aria-label="Buscar empresa" />
          <span class="admin-table-count" data-table-count></span>
        </div>
        <table class="admin-table" data-admin-table data-page-size="20">
          <thead>
            <tr><th data-sort="text">Nombre</th><th data-sort="text">Slug</th><th></th></tr>
          </thead>
          <tbody>
            {empresas.map((e) => (
              <tr>
                <td class="admin-table__titulo"><a href={`/admin/empresas/${e.id}`}>{e.nombre}</a></td>
                <td>{e.slug}</td>
                <td><a href={`/admin/empresas/${e.id}`}>Editar</a></td>
              </tr>
            ))}
          </tbody>
        </table>
        <nav class="admin-pager" data-pager aria-label="Paginado de empresas"></nav>
      </div>
    )}
    {empresas.length === 0 && !errorCarga && <p>No hay empresas todavía. Cargá la primera con el formulario de abajo.</p>}

    <h2>Nueva empresa</h2>
    <form class="admin-form" method="post" action="/api/admin/empresas">
      <AdminCampo titulo="Nombre" ayuda="Cómo figura la organización en el panel. No se publica si la instancia es privada o anonimizada.">
        <input type="text" name="nombre" required />
      </AdminCampo>
      <AdminCampo titulo="Rubro" ayuda="Sector o actividad, para tu orden interno. Ejemplo: ferroviario, saneamiento, sindicato.">
        <input type="text" name="rubro" />
      </AdminCampo>
      <AdminCampo titulo="Contacto" ayuda="Nombre de la persona de referencia (RRHH, delegado, etc.). Solo lo ves vos.">
        <input type="text" name="contactoNombre" />
      </AdminCampo>
      <AdminCampo titulo="Email" ayuda="Interno: nunca se muestra en el sitio. Sirve para que vos sepas a quién escribir.">
        <input type="email" name="contactoEmail" />
      </AdminCampo>
      <AdminCampo titulo="Teléfono" ayuda="Interno: nunca se muestra en el sitio.">
        <input type="text" name="contactoTelefono" />
      </AdminCampo>
      <AdminCampo titulo="Notas internas" ayuda="Recordatorios para vos: cómo se llegó a esta organización, acuerdos, lo que no conviene olvidar.">
        <textarea name="notasInternas" rows="3"></textarea>
      </AdminCampo>
      <button type="submit">Crear</button>
    </form>
  </AdminChrome>
</Layout>

<script src="/admin/table-utils.js" defer></script>
