---
import Layout from '../../../layouts/Layout.astro';
import AdminChrome from '../../../components/AdminChrome.astro';
import { db } from '../../../lib/firebase-admin';

let empresas: { id: string; nombre: string; slug: string }[] = [];
let errorCarga = '';
try {
  const snap = await db().collection('empresas').orderBy('nombre').get();
  empresas = snap.docs.map((d) => ({
    id: d.id,
    nombre: String(d.data().nombre ?? ''),
    slug: String(d.data().slug ?? ''),
  }));
} catch (err) {
  errorCarga = err instanceof Error ? err.message : 'No se pudieron leer las empresas.';
}
---
<Layout title="Empresas — Admin" noindex={true} whatsapp={false}>
  <AdminChrome titulo="Empresas">
    {errorCarga && <p class="admin-alert">{errorCarga}</p>}
    {empresas.length > 0 && (
      <table class="admin-table">
        <thead>
          <tr><th>Nombre</th><th>Slug</th><th></th></tr>
        </thead>
        <tbody>
          {empresas.map((e) => (
            <tr>
              <td>{e.nombre}</td>
              <td>{e.slug}</td>
              <td><a href={`/admin/empresas/${e.id}`}>Editar</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
    {empresas.length === 0 && !errorCarga && <p>No hay empresas todavía.</p>}

    <h2>Nueva empresa</h2>
    <form class="admin-form" method="post" action="/api/admin/empresas">
      <label>Nombre <input type="text" name="nombre" required /></label>
      <label>Rubro <input type="text" name="rubro" /></label>
      <label>Contacto <input type="text" name="contactoNombre" /></label>
      <label>Email (interno, nunca público) <input type="email" name="contactoEmail" /></label>
      <label>Teléfono (interno, nunca público) <input type="text" name="contactoTelefono" /></label>
      <label>Notas internas <textarea name="notasInternas" rows="3"></textarea></label>
      <button type="submit">Crear</button>
    </form>
  </AdminChrome>
</Layout>
