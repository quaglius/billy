---
import { existsSync } from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import BotonPrimario from '../components/BotonPrimario.astro';
import ProcesoTrabajo from '../components/ProcesoTrabajo.astro';
import OrganizacionesSlider from '../components/OrganizacionesSlider.astro';
import RedesFeed from '../components/RedesFeed.astro';
import { WHATSAPP_URL } from '../lib/site';
import { listarPostsPublicados } from '../lib/posts';
import { coverMeta, CURSO_COVERS } from '../lib/covers';

const heroDir = path.join(process.cwd(), 'public/fotos/guille');
const heroSrc = existsSync(path.join(heroDir, 'hero-brazos-cruzados.png'))
  ? '/fotos/guille/hero-brazos-cruzados.png'
  : null;
const heroSrc2x = existsSync(path.join(heroDir, 'hero-hires-sonrisa.png'))
  ? '/fotos/guille/hero-hires-sonrisa.png'
  : null;

const postsRecientes = (await listarPostsPublicados()).slice(0, 3);

const pilares = [
  {
    titulo: 'Escuchar',
    texto: 'Diagnóstico inicial de la organización, con mandos y delegados.',
    icono: '/shapes/feature-expert-advice.svg',
  },
  {
    titulo: 'Nombrar',
    texto: 'Abrir el tema sin estigmatizar: consumo y salud mental en palabras.',
    icono: '/shapes/feature-quick-solutions.svg',
  },
  {
    titulo: 'Equipar',
    texto: 'Herramientas concretas para delegados, mandos medios y trabajadores.',
    icono: '/shapes/feature-strategic-planning.svg',
  },
  {
    titulo: 'Sostener',
    texto: 'Seguimiento en el tiempo, no una charla suelta.',
    icono: '/shapes/feature-efficient-operations.svg',
  },
];

const servicios = [
  {
    nombre: 'Encuentro',
    formato: '90 min a media jornada',
    paraQuien: 'Toda la planta, sin distinción de rango',
    queSeLleva: 'Sensibilización + actividades en vivo + página de recursos',
    foto: CURSO_COVERS.encuentro.src,
    posicion: CURSO_COVERS.encuentro.position,
    alt: 'Equipo de planta en un predio, con ropa de trabajo, después de una jornada de sensibilización',
  },
  {
    nombre: 'Taller',
    formato: '1-2 jornadas',
    paraQuien: 'Delegados, supervisores, RRHH',
    queSeLleva: 'Herramientas de detección, escucha y derivación + protocolo básico',
    foto: CURSO_COVERS.taller.src,
    posicion: CURSO_COVERS.taller.position,
    alt: 'Taller con delegados alrededor de una mesa de trabajo',
  },
  {
    nombre: 'Programa',
    formato: '2-3 meses, encuentros quincenales',
    paraQuien: 'Organización completa',
    queSeLleva: 'Diagnóstico, ciclo de encuentros, protocolo de actuación propio, certificados y reporte agregado',
    foto: CURSO_COVERS.programa.src,
    posicion: CURSO_COVERS.programa.position,
    alt: 'Cierre de un programa de prevención, con certificados',
  },
];

const testimonios = [
  {
    cita: 'Guillermo nos ayudó a abrir un tema que durante años fue tabú en el sindicato. Los delegados hoy tienen herramientas concretas para acompañar a un compañero, y eso cambió la forma en que se manejan los conflictos en planta.',
    organizacion: 'SITOS',
    logo: '/marca/ejemplo/sitos.svg',
  },
  {
    cita: 'Lo contratamos para una charla puntual y terminamos armando un programa de varios meses. La diferencia con otras capacitaciones es que no se queda en la teoría: da herramientas que los mandos medios usan al día siguiente.',
    organizacion: 'Fundación Provincia ART',
    logo: '/marca/ejemplo/fundacion-provincia-art.svg',
  },
  {
    cita: 'Trabajamos con Guillermo desde hace años en distintas líneas. Lo que más valoramos es la cercanía: entiende la realidad del trabajador ferroviario, no llega con un power point genérico.',
    organizacion: 'Trenes Argentinos Línea Roca',
    logo: '/marca/ejemplo/linea-roca.svg',
  },
];
---
<Layout title="Guille Nuesch — Salud mental en el trabajo">
  <section class="hero">
    <div class="hero__grid page-shell">
      <div class="wow fadeInUp" data-wow-delay="0.2s">
        <p class="eyebrow">Salud mental en el trabajo</p>
        <h1 class="hero-title text-anim">Prevención de consumos problemáticos en el <span>trabajo</span></h1>
        <p class="hero-lead">Lo peor que podemos hacer, es no hacer nada.</p>
        <BotonPrimario href={WHATSAPP_URL} texto="Escribime por WhatsApp" target="_blank" />
      </div>
      <div class="hero__photo wow fadeInUp" data-wow-delay="0.5s">
        <img class="hero-shapes-img" src="/shapes/h5-hero-shape-1.svg" alt="" aria-hidden="true" />
        {heroSrc ? (
          <img
            class="hero-cutout"
            src={heroSrc}
            srcset={heroSrc2x ? `${heroSrc} 531w, ${heroSrc2x} 1086w` : undefined}
            sizes="(min-width: 768px) 531px, 90vw"
            alt="Guillermo Nuesch"
            width="531"
            height="531"
          />
        ) : (
          <div class="hero-placeholder">
            Foto de portada pendiente
            <small>Colocar public/fotos/guille/hero-brazos-cruzados.png — no se inventa recorte.</small>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="features wow fadeInUp" data-wow-delay="0.4s">
    {pilares.map((p) => (
      <div class="feature-item">
        <img class="feature-item__icon" src={p.icono} alt="" width="64" height="64" />
        <h2>{p.titulo}</h2>
        <p>{p.texto}</p>
      </div>
    ))}
  </section>

  <ProcesoTrabajo prefijo="home-proceso" />

  <OrganizacionesSlider />

  <section class="page-shell wow fadeInUp" data-wow-delay="0.5s">
    <p class="eyebrow">Servicios</p>
    <h2 class="text-anim">Encuentro, Taller y Programa</h2>
    <div class="productos">
      {servicios.map((p) => (
        <article class="producto">
          <div class="producto__thumb">
            <img src={p.foto} alt={p.alt} width="640" height="400" style={`object-position: ${p.posicion}`} />
          </div>
          <div class="producto__body">
            <h3>{p.nombre}</h3>
            <p>{p.formato}</p>
            <p>{p.paraQuien}</p>
            <p>{p.queSeLleva}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="servicios-cta">
      <BotonPrimario href="/cursos" texto="Ver cursos" />
    </p>
  </section>

  <section class="page-shell wow fadeInUp" data-wow-delay="0.6s">
    <p class="eyebrow">Testimonios</p>
    <h2 class="text-anim">Lo que dicen las organizaciones</h2>
    <div class="testimonios">
      {testimonios.map((t) => (
        <blockquote>
          <div class="testimonio__who">
            <img class="testimonio__logo" src={t.logo} alt="" width="72" height="72" />
          </div>
          <p>{t.cita}</p>
          <footer>{t.organizacion}</footer>
        </blockquote>
      ))}
    </div>
  </section>

  <section class="page-shell wow fadeInUp" data-wow-delay="0.4s">
    <p class="eyebrow">Blog</p>
    <h2 class="text-anim">Notas recientes</h2>
    {postsRecientes.length === 0 ? (
      <p>Todavía no hay notas publicadas. Los borradores se cargan desde el panel.</p>
    ) : (
      <div class="home-posts">
        {postsRecientes.map((p) => (
          <a class="curso-card" href={`/blog/${p.slug}`}>
            <span class="curso-card__thumb">
              <img
                src={coverMeta(p.slug, p.imagenPortadaUrl).src}
                alt=""
                width="640"
                height="400"
                style={`object-position: ${coverMeta(p.slug, p.imagenPortadaUrl).position}`}
              />
            </span>
            <div class="curso-card__body">
              <h3>{p.titulo}</h3>
              <p>{p.bajada}</p>
            </div>
          </a>
        ))}
      </div>
    )}
    <p><a class="line-hover" href="/blog">Ir al blog</a></p>
  </section>

  <RedesFeed />

  <section class="page-shell cta-final">
    <h2 class="text-anim">Si estás buscando generar un impacto real en tu equipo de trabajo, podemos trabajar juntos.</h2>
    <BotonPrimario href={WHATSAPP_URL} texto="Escribime por WhatsApp" target="_blank" />
  </section>
</Layout>
