---
import FlujoPasos from './FlujoPasos.astro';
import BotonPrimario from './BotonPrimario.astro';
import { PASOS_METODO } from '../lib/proceso';
import { WHATSAPP_METODO } from '../lib/site';

interface Props {
  mostrarMetodoCompleto?: boolean;
  prefijo?: string;
}

const { mostrarMetodoCompleto = false, prefijo = 'proceso' } = Astro.props;
---
<section class="proceso page-shell wow fadeInUp" data-wow-delay="0.3s">
  <p class="eyebrow">Cómo trabajo</p>
  <h2 class="text-anim">Un proceso, no una charla suelta</h2>
  <FlujoPasos pasos={[...PASOS_METODO]} prefijo={prefijo} />
  <div class="flujo-cta">
    <BotonPrimario href={WHATSAPP_METODO} texto="Conocer más" target="_blank" />
    {mostrarMetodoCompleto && (
      <p><a class="line-hover" href="/sobre-mi">Ver el método completo</a></p>
    )}
  </div>
</section>
