---
import { ORGANIZACIONES } from '../lib/organizaciones';
---
<section class="orgs page-shell wow fadeInUp" data-wow-delay="0.35s">
  <div class="org-slider">
    <button class="org-slider__nav" type="button" data-dir="-1" aria-label="Organizaciones anteriores">
      <span aria-hidden="true">←</span>
    </button>
    <div class="org-slider__viewport" tabindex="0">
      <ul class="org-slider__track">
        {ORGANIZACIONES.map((o) => (
          <li class="org-slider__item" title={o.nombre}>
            <div class:list={['org-slider__logo', { 'org-slider__logo--dark': o.fondoOscuro, 'org-slider__logo--wordmark': !o.logo }]}>
              {o.logo ? (
                <img src={o.logo} alt="" width="112" height="64" loading="lazy" />
              ) : (
                <span aria-hidden="true">{o.corto}</span>
              )}
            </div>
            <span>{o.corto}</span>
          </li>
        ))}
      </ul>
    </div>
    <button class="org-slider__nav" type="button" data-dir="1" aria-label="Organizaciones siguientes">
      <span aria-hidden="true">→</span>
    </button>
  </div>
  <h2 class="orgs__titulo">Donde trabajé</h2>
</section>
<script>
  document.querySelectorAll('.org-slider').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('.org-slider__viewport');
    root.querySelectorAll<HTMLButtonElement>('.org-slider__nav').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.dir ?? 1);
        viewport?.scrollBy({ left: dir * 220, behavior: 'smooth' });
      });
    });
  });
</script>
