---
import { coverMeta } from '../lib/covers';
import { formatFecha } from '../lib/posts';
import BotonPrimario from './BotonPrimario.astro';

interface Props {
  slug: string;
  titulo: string;
  bajada: string;
  imagenPortadaUrl?: string | null;
  publicadoEn?: Date | null;
}

const { slug, titulo, bajada, imagenPortadaUrl, publicadoEn } = Astro.props;
const cover = coverMeta(slug, imagenPortadaUrl);
const fecha = formatFecha(publicadoEn ?? null);
---
<article class="post-card">
  <a class="post-card__thumb" href={`/blog/${slug}`}>
    <img src={cover.src} alt="" width="800" height="500" style={`object-position: ${cover.position}`} />
    {fecha.mes && (
      <span class="post-card__date">
        <span class="post-card__day">{fecha.dia}</span>
        <span class="post-card__month">{fecha.mes}</span>
      </span>
    )}
  </a>
  <div class="post-card__body">
    <p class="post-card__meta"><span>Notas</span></p>
    <h3><a href={`/blog/${slug}`}>{titulo}</a></h3>
    <p class="post-card__excerpt">{bajada}</p>
    <BotonPrimario href={`/blog/${slug}`} texto="Leer más" />
  </div>
</article>
