---
interface Props {
  titulo: string;
}

const path = Astro.url.pathname;
const { titulo } = Astro.props;
const links = [
  { href: '/admin', label: 'Inicio' },
  { href: '/admin/cursos', label: 'Cursos' },
  { href: '/admin/empresas', label: 'Empresas' },
  { href: '/admin/instancias', label: 'Instancias' },
  { href: '/admin/posts', label: 'Posts' },
  { href: '/admin/observatorio', label: 'Observatorio' },
];
---
<div class="admin-chrome page-shell">
  <h1>{titulo}</h1>
  <nav class="admin-chrome__nav" aria-label="Admin">
    {links.map((l) => (
      <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
    ))}
    <form method="post" action="/api/logout">
      <button class="admin-logout" type="submit">Salir</button>
    </form>
  </nav>
  <slot />
</div>
