---
interface Props {
  href: string;
  texto: string;
  variante?: 'default' | 'header';
  target?: '_self' | '_blank';
}

const { href, texto, variante = 'default', target = '_self' } = Astro.props;
---
<a
  class:list={['tj-primary-btn', variante === 'header' && 'header_btn']}
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
>
  <span class="btn_inner">
    <span class="btn_icon">
      <i class="tji-arrow-right" aria-hidden="true"></i>
    </span>
    <span class="btn_text"><span>{texto}</span></span>
  </span>
</a>
