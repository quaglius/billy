---
import IconoRed from './IconoRed.astro';
import { FACEBOOK_URL, INSTAGRAM_URL, YOUTUBE_URL, LINKEDIN_URL, NAV } from '../lib/site';
const year = new Date().getFullYear();
const redes = [
  { href: INSTAGRAM_URL, label: 'Instagram', red: 'instagram' as const },
  { href: FACEBOOK_URL, label: 'Facebook', red: 'facebook' as const },
  { href: YOUTUBE_URL, label: 'YouTube', red: 'youtube' as const },
  { href: LINKEDIN_URL, label: 'LinkedIn', red: 'linkedin' as const },
];
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__col">
      <a class="site-footer__logo" href="/">
        <img src="/marca/logo-horizontal.svg" alt="Guille Nuesch" height="36" />
      </a>
      <p class="site-footer__desc">
        Salud mental y prevención de consumos problemáticos en el trabajo. Charlas, talleres y programas en plantas, sindicatos y ART.
      </p>
    </div>
    <div class="site-footer__col">
      <h2>Sitio</h2>
      <nav aria-label="Pie">
        {NAV.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </div>
    <div class="site-footer__col">
      <h2>Recursos</h2>
      <nav aria-label="Recursos">
        <a href="/cursos">Cursos</a>
        <a href="/blog">Blog</a>
        <a href="/ayuda">Si necesitás ayuda</a>
      </nav>
    </div>
    <div class="site-footer__col">
      <h2>Seguime</h2>
      <div class="site-footer__social">
        {redes.map((r) => (
          <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={r.label}>
            <IconoRed red={r.red} />
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="site-footer__copy">© {year} Guille Nuesch</div>
</footer>
