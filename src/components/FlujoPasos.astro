---
interface Paso {
  titulo: string;
  texto: string;
}

interface Props {
  pasos: Paso[];
  prefijo?: string;
}

const { pasos, prefijo = 'flujo' } = Astro.props;
---
<ol class="flujo" data-flujo={prefijo}>
  {pasos.map((p, i) => (
    <li class="flujo__paso">
      <span class="flujo__num" aria-hidden="true">{i + 1}</span>
      <h3 class="flujo__titulo">
        <button
          type="button"
          class="flujo__btn"
          id={`${prefijo}-btn-${i}`}
          aria-expanded={i === 0 ? 'true' : 'false'}
          aria-controls={`${prefijo}-panel-${i}`}
        >
          {p.titulo}
          <span class="flujo__plus" aria-hidden="true"></span>
        </button>
      </h3>
      <div
        class="flujo__panel"
        id={`${prefijo}-panel-${i}`}
        role="region"
        aria-labelledby={`${prefijo}-btn-${i}`}
        hidden={i !== 0}
      >
        <p>{p.texto}</p>
      </div>
    </li>
  ))}
</ol>
<script>
  document.querySelectorAll<HTMLElement>('.flujo').forEach((root) => {
    root.querySelectorAll<HTMLButtonElement>('.flujo__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const wasOpen = btn.getAttribute('aria-expanded') === 'true';
        root.querySelectorAll<HTMLButtonElement>('.flujo__btn').forEach((other) => {
          const open = other === btn && !wasOpen;
          other.setAttribute('aria-expanded', open ? 'true' : 'false');
          const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !open;
        });
      });
    });
  });
</script>
