---
interface Paso {
  titulo: string;
  texto: string;
}

interface Props {
  pasos: Paso[];
  prefijo?: string;
}

const { pasos, prefijo = 'flujo' } = Astro.props;
---
<div class="flujo" data-flujo={prefijo}>
  {pasos.map((p, i) => (
    <div class="flujo__item">
      <h3 class="flujo__cabecera">
        <button
          type="button"
          class="flujo__tab"
          id={`${prefijo}-tab-${i}`}
          aria-expanded={i === 0 ? 'true' : 'false'}
          aria-controls={`${prefijo}-panel-${i}`}
        >
          <span class="flujo__num" aria-hidden="true">{i + 1}</span>
          <span class="flujo__nombre">{p.titulo}</span>
          <span class="flujo__chevron" aria-hidden="true"></span>
        </button>
      </h3>
      <div
        class="flujo__contenido"
        id={`${prefijo}-panel-${i}`}
        role="region"
        aria-labelledby={`${prefijo}-tab-${i}`}
        hidden={i === 0 ? undefined : true}
      >
        <div class="flujo__detalle"><p>{p.texto}</p></div>
      </div>
    </div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-flujo]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('.flujo__item')];

    function set(item: HTMLElement, abierto: boolean) {
      const tab = item.querySelector<HTMLButtonElement>('.flujo__tab');
      const panel = item.querySelector<HTMLElement>('.flujo__contenido');
      if (!tab || !panel) return;
      tab.setAttribute('aria-expanded', String(abierto));
      panel.hidden = !abierto;
    }

    items.forEach((item) => {
      const tab = item.querySelector<HTMLButtonElement>('.flujo__tab');
      tab?.addEventListener('click', () => {
        const yaAbierto = tab.getAttribute('aria-expanded') === 'true';
        items.forEach((other) => set(other, other === item && !yaAbierto));
      });
    });
  });
</script>
