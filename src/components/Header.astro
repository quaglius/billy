---
import BotonPrimario from './BotonPrimario.astro';
import { NAV, WHATSAPP_URL } from '../lib/site';

const path = Astro.url.pathname;
---
<header class="site-header">
  <a class="site-header__logo" href="/">
    <img src="/marca/logo-horizontal.svg" alt="Guille Nuesch" height="40" />
  </a>
  <nav class="site-nav" aria-label="Principal">
    {NAV.map((item) => (
      <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
  <div class="site-header__cta">
    <BotonPrimario href={WHATSAPP_URL} texto="WhatsApp" variante="header" target="_blank" />
  </div>
</header>
