---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/boton.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import MarcaMotion from '../components/MarcaMotion.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string | null;
}

const {
  title = 'Guille Nuesch',
  description = 'Salud mental y prevención de consumos problemáticos en el trabajo.',
  noindex = false,
  ogImage = null,
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/marca/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,400&family=Libre+Franklin:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFlotante />
    <MarcaMotion />
  </body>
</html>
